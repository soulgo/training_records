{
  "name": "training-records-dashboard",
  "version": "1.2.5",
  "private": true,
  "description": "Hexo dashboard for Markdown-based training records",
  "scripts": {
    "test": "node --test",
    "test:fast": "node --test --test-skip-pattern \"dashboard renders|dashboard defaults|dashboard chart script|dashboard embeds|dashboard explains|dashboard fallback view|homepage|thoughts page|thought detail page|thought module pages\"",
    "check:derived-data-merge": "node tools/check-derived-data-merge.mjs",
    "build:data": "node tools/generate-training-data.mjs",
    "backfill:core": "node tools/training-maintenance.mjs sync --phase archive",
    "backfill:thoughts": "node tools/training-maintenance.mjs sync --phase thoughts",
    "export:markdown": "node tools/training-maintenance.mjs export markdown",
    "import:markdown": "node tools/training-maintenance.mjs sync --phase markdown",
    "reconcile:markdown": "node tools/training-maintenance.mjs sync --phase markdown",
    "sync:db": "node tools/training-maintenance.mjs sync",
    "maintenance:inspect": "node tools/training-maintenance.mjs inspect",
    "maintenance:sync": "node tools/training-maintenance.mjs sync",
    "maintenance:migrate": "node tools/training-maintenance.mjs migrate",
    "build:site": "node tools/run-hexo-command.mjs generate",
    "build": "npm run build:data && npm run build:site",
    "clean": "node tools/run-hexo-command.mjs clean",
    "server": "npm run build:data && node tools/run-hexo-command.mjs server",
    "merge:dev-to-main": "node tools/merge-dev-to-main.mjs",
    "sync:telegram": "node tools/telegram-sync.mjs",
    "telegram:sync": "npm run sync:telegram",
    "telegram:webhook": "node tools/telegram-webhook.mjs"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-cli": "^4.3.2",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "pg": "^8.16.3"
  }
}
