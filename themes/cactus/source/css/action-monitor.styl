.action-monitor-page
  position relative
  margin-top 1.25rem
  display flex
  flex-direction column
  gap 1rem
  color #0f2d4a
  background linear-gradient(180deg, #eef8ff 0%, #f8fbff 24%, #ffffff 100%)

.action-monitor-page:before
  content ""
  position absolute
  inset 0
  pointer-events none
  background linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 18%)

.action-monitor-page h1,
.action-monitor-page h2,
.action-monitor-page h3,
.action-monitor-page p
  margin 0

.action-monitor
  position relative
  display block

.action-monitor__header
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  margin-bottom 1.25rem

.action-monitor__header h1
  color #153b5d
  font-size 2rem
  line-height 1.15

.action-monitor__eyebrow
  display inline-flex
  align-items center
  margin-bottom 0.35rem
  color #2563eb
  font-size 0.8rem
  font-weight 800
  line-height 1
  letter-spacing 0.08em
  text-transform uppercase

.action-monitor__meta
  display flex
  align-items center
  justify-content flex-end
  flex-wrap wrap
  gap 0.5rem
  color #5f7088
  font-size 0.9rem

.action-monitor__meta span
  display inline-flex
  align-items center
  min-height 2rem
  padding 0.32rem 0.78rem
  border-radius 999px
  background #f8fafc
  border 1px solid #dbe7f3
  line-height 1

.action-monitor__meta span:first-child
  color #2563eb
  background #eaf2ff
  border-color #cfe0ff
  font-weight 800

.action-monitor__summary
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 0.85rem
  margin-bottom 1.05rem

.parameter-validity
  margin 1.1rem 0 1.35rem
  padding-top 1rem
  border-top 1px solid #e2edf7

.parameter-validity__summary
  display grid
  grid-template-columns repeat(5, minmax(0, 1fr))
  gap 0.85rem
  margin-bottom 1rem

.action-monitor__summary-card,
.action-monitor__empty,
.action-run,
.parameter-validity__row
  background rgba(255, 255, 255, 0.88)
  border 1px solid rgba(191, 219, 254, 0.85)
  box-shadow 0 18px 48px rgba(30, 64, 175, 0.09)
  backdrop-filter blur(12px)

.action-monitor__summary-card
  min-height 6.4rem
  padding 0.95rem 1rem
  border-radius 16px

.action-monitor__summary-card span
  display block
  color #64748b
  font-size 0.82rem
  font-weight 800

.action-monitor__summary-card strong
  display block
  margin 0.42rem 0 0.34rem
  color #153b5d
  font-size 1.8rem
  line-height 1.05

.action-monitor__summary-card small
  display block
  color #7188a0
  font-size 0.86rem
  line-height 1.35

.action-monitor__subheader,
.action-monitor__history-heading
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  margin 0.45rem 0 0.9rem

.action-monitor__subheader h2,
.action-monitor__history-heading h2
  color #153b5d
  font-size 1.18rem
  line-height 1.25

.action-monitor__subheader span
  display block
  margin-top 0.28rem
  color #64748b
  font-size 0.92rem

.action-monitor__runs
  display flex
  flex-direction column
  gap 0.75rem

.action-monitor__runs--history
  margin-top 0.75rem

.action-monitor__history
  margin-top 1.1rem
  padding-top 1rem
  border-top 1px solid #e2edf7

.action-monitor__history-controls
  display flex
  align-items center
  justify-content flex-end
  flex-wrap wrap
  gap 0.5rem
  color #64748b
  font-size 0.86rem

.action-monitor__history-nav
  min-width 4.25rem
  min-height 2rem
  padding 0.35rem 0.75rem
  border 1px solid #d6e3f0
  border-radius 8px
  background #ffffff
  color #153b5d
  font-size 0.82rem
  font-weight 800
  cursor pointer

.action-monitor__history-nav:disabled
  cursor not-allowed
  opacity 0.45

.action-monitor__empty
  display flex
  flex-direction column
  gap 0.35rem
  min-height 5.4rem
  padding 1rem
  border-radius 16px
  color #64748b

.action-monitor__empty strong
  color #153b5d
  font-size 1rem
  line-height 1.25

.action-monitor__empty span
  font-size 0.86rem
  line-height 1.55

.action-monitor__empty--compact
  min-height auto
  margin-bottom 0.75rem

.parameter-validity__table
  display flex
  flex-direction column
  gap 0.58rem
  width 100%
  max-width 100%
  overflow hidden

.parameter-validity__body
  display flex
  flex-direction column
  gap 0.58rem

.parameter-validity__controls
  display flex
  align-items center
  justify-content flex-end
  flex-wrap wrap
  gap 0.5rem
  margin -0.2rem 0 0.7rem
  color #64748b
  font-size 0.86rem

.parameter-validity__row
  display grid
  grid-template-columns minmax(0, 1.15fr) minmax(0, 0.58fr) minmax(0, 0.92fr) minmax(0, 0.62fr) minmax(0, 0.72fr) minmax(0, 0.72fr) minmax(0, 1.18fr)
  align-items center
  gap 0.75rem
  width 100%
  box-sizing border-box
  min-height 3.75rem
  padding 0.78rem 0.92rem
  border-radius 12px
  color #334155
  font-size 0.84rem
  line-height 1.35

.parameter-validity__row--head
  min-height auto
  background transparent
  border 0
  box-shadow none
  color #64748b
  font-size 0.78rem
  font-weight 800
  text-transform uppercase

.parameter-validity__row span
  min-width 0
  overflow hidden
  text-overflow ellipsis
  overflow-wrap anywhere

.parameter-validity__row strong
  color #0f2d4a
  font-size 0.9rem
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.parameter-validity__row span:last-child
  white-space normal

.parameter-validity__row em
  display inline-flex
  align-items center
  min-height 1.7rem
  padding 0.24rem 0.56rem
  border-radius 999px
  background #f1f5f9
  color #475569
  font-style normal
  font-size 0.78rem
  font-weight 800
  line-height 1

.parameter-validity__row small
  display block
  margin-top 0.2rem
  color #64748b
  font-size 0.76rem
  font-weight 700

.parameter-validity__row--success em
  background #dcfce7
  color #15803d

.parameter-validity__row--warning em
  background #fef3c7
  color #a16207

.parameter-validity__row--failure em
  background #fee2e2
  color #b91c1c

.parameter-validity__row--neutral em
  background #e2e8f0
  color #475569

.action-run
  display grid
  grid-template-columns auto minmax(0, 1fr) auto auto
  align-items center
  gap 0.9rem
  min-height 5.6rem
  padding 0.95rem 1rem
  border-radius 16px
  color inherit
  text-decoration none
  transition transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease

.action-run:hover
  color inherit
  transform translateY(-1px)
  border-color #93c5fd
  box-shadow 0 22px 54px rgba(37, 99, 235, 0.12)

.action-run__status
  width 0.88rem
  height 0.88rem
  border-radius 999px
  background #94a3b8
  box-shadow 0 0 0 4px rgba(148, 163, 184, 0.14)

.action-run--success .action-run__status
  background #22c55e
  box-shadow 0 0 0 4px rgba(34, 197, 94, 0.14)

.action-run--failure .action-run__status
  background #ef4444
  box-shadow 0 0 0 4px rgba(239, 68, 68, 0.14)

.action-run--running .action-run__status
  background #2563eb
  box-shadow 0 0 0 4px rgba(37, 99, 235, 0.14)

.action-run__main
  min-width 0

.action-run__main h3
  margin 0 0 0.35rem
  color #0f2d4a
  font-size 1.05rem
  line-height 1.25
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.action-run__main p
  display flex
  align-items center
  flex-wrap wrap
  gap 0.35rem 0.65rem
  color #64748b
  font-size 0.88rem
  font-weight 700
  line-height 1.35

.action-run__main strong
  color #334155
  font-weight 800

.action-run__error
  display block
  margin-top 0.4rem
  color #b91c1c
  font-size 0.82rem
  line-height 1.35
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.action-run__branch
  justify-self center
  padding 0.28rem 0.58rem
  border-radius 999px
  background #eaf2ff
  color #2563eb
  font-size 0.82rem
  font-weight 800
  line-height 1

.action-run__metrics
  display flex
  flex-direction column
  align-items flex-start
  gap 0.34rem
  min-width 6.2rem
  color #64748b
  font-size 0.88rem
  font-weight 800

.action-run__metrics span
  display block
  line-height 1.1

@media (max-width: 1180px)
  .action-monitor__summary,
  .parameter-validity__summary
    grid-template-columns repeat(2, minmax(0, 1fr))

  .parameter-validity__row
    grid-template-columns minmax(0, 1fr) minmax(0, 0.55fr) minmax(0, 0.8fr) minmax(0, 0.6fr)

  .parameter-validity__row span:nth-child(5),
  .parameter-validity__row span:nth-child(6),
  .parameter-validity__row span:nth-child(7)
    grid-column auto

@media (max-width: 860px)
  .action-monitor__summary,
  .parameter-validity__summary
    grid-template-columns 1fr

  .parameter-validity__row,
  .parameter-validity__row--head
    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)

  .parameter-validity__row--head
    display none

  .action-run
    grid-template-columns auto minmax(0, 1fr) auto

  .action-run__metrics
    grid-column 2 / -1
    flex-direction row
    flex-wrap wrap
    min-width 0

@media (max-width: 640px)
  .action-monitor-page
    margin-top 1rem

  .action-monitor__header,
  .action-monitor__subheader,
  .action-monitor__history-heading
    align-items flex-start
    flex-direction column

  .action-monitor__header h1
    font-size 1.75rem

  .action-monitor__meta,
  .action-monitor__history-controls,
  .parameter-validity__controls
    justify-content flex-start

  .action-monitor__summary-card,
  .action-monitor__empty,
  .action-run,
  .parameter-validity__row
    padding 1rem

  .parameter-validity__row
    grid-template-columns 1fr

  .parameter-validity__row strong
    white-space normal

  .action-run
    align-items flex-start
    gap 0.7rem

  .action-run__main h3,
  .action-run__error
    white-space normal
