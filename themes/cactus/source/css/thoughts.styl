.thoughts-page
  margin-top 2.5rem

.thoughts-empty
  padding 1.25rem
  border-radius 18px
  background #f0fdf4
  color #166534
  border 1px solid #86efac

.thoughts-list
  display grid
  gap 1rem

.thought-card
  padding 1.35rem 1.4rem
  border-radius 20px
  border 1px solid #e5e7eb
  background linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)
  box-shadow 0 18px 45px rgba(15, 23, 42, 0.05)

.thought-card__meta
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  margin-bottom 0.65rem
  color #64748b
  font-size 0.92rem

.thought-card__meta-right
  display flex
  align-items center
  justify-content flex-end
  gap 0.5rem
  flex-wrap wrap
  min-width 0

.thought-card__tags
  display flex
  flex-wrap wrap
  gap 0.45rem

.thought-card__tags span
  padding 0.28rem 0.55rem
  border-radius 999px
  background #dbeafe
  color #1d4ed8
  font-size 0.8rem

.thought-card__id
  appearance none
  display inline-flex
  align-items center
  flex: 0 0 auto
  padding 0.18rem 0.5rem
  border-radius 999px
  border 1px solid #cbd5e1
  background #ffffff
  color #475569
  cursor pointer
  font-family inherit
  font-size 0.76rem
  line-height 1
  white-space nowrap

.thought-card__id:hover
  border-color #93c5fd
  color #1d4ed8

.thought-card__id:focus-visible
  outline 2px solid #93c5fd
  outline-offset 2px

.thought-card__body
  color #334155

.thought-card__body > :first-child
  margin-top 0

.thought-card__body > :last-child
  margin-bottom 0

.thought-card__read-more
  display inline-flex
  align-items center
  margin-top 0.85rem
  color #2563eb
  font-size 0.92rem
  font-weight 600

.thought-card__read-more:hover
  color #1d4ed8

.thought-card__photos
  display grid
  grid-template-columns repeat(auto-fill, minmax(9rem, 1fr))
  gap 0.7rem
  margin-top 1rem

.thought-card__photos a
  display block
  overflow hidden
  border-radius 8px
  background #e2e8f0
  aspect-ratio 4 / 3

.thought-card__photos img
  display block
  width 100%
  height 100%
  object-fit cover

.thoughts-pagination
  display flex
  align-items center
  justify-content center
  gap 0.75rem
  margin-top 1.5rem

.thoughts-pagination__link
  display inline-flex
  align-items center
  justify-content center
  min-width 4.5rem
  padding 0.45rem 0.85rem
  border 1px solid #cbd5e1
  border-radius 8px
  background #ffffff
  color #2563eb
  font-size 0.9rem
  line-height 1.2

.thoughts-pagination__link:hover
  border-color #93c5fd
  color #1d4ed8

.thoughts-pagination__link--disabled
  color #94a3b8
  cursor default

.thoughts-pagination__status
  color #64748b
  font-size 0.9rem

@media (max-width: 720px)
  .thoughts-page
    margin-top 1.5rem

  .thought-card__meta
    align-items flex-start
    flex-direction column

  .thought-card__meta-right
    justify-content flex-start

  .thought-card__photos
    grid-template-columns repeat(auto-fill, minmax(7.5rem, 1fr))

  .thoughts-pagination
    gap 0.5rem

  .thoughts-pagination__link
    min-width 4rem
    padding 0.42rem 0.65rem
