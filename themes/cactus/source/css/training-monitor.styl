.monitor-page
  margin-top 1.1rem
  display flex
  flex-direction column
  gap 1rem
  color #172033

.monitor-page h1,
.monitor-page h2,
.monitor-page h3,
.monitor-page p
  margin 0

.monitor-header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  padding-bottom 0.8rem
  border-bottom 1px solid #d8e2ef

.monitor-header h1
  margin-top 0.32rem
  color #0f1f35
  font-size 1.58rem
  line-height 1.2
  letter-spacing 0

.monitor-header__subtitle
  margin-top 0.45rem !important
  color #64748b
  font-size 0.9rem

.monitor-eyebrow
  display block
  color #2563eb
  font-size 0.7rem
  font-weight 800
  line-height 1
  letter-spacing 0.08em

.monitor-header__meta
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 0.45rem
  color #64748b
  font-size 0.82rem

.monitor-header__meta span
  display inline-flex
  align-items center
  gap 0.35rem
  min-height 2rem
  padding 0.34rem 0.58rem
  border 1px solid #d8e2ef
  border-radius 999px
  background #ffffff

.monitor-header__meta strong
  color #111827

.monitor-report-panel,
.monitor-summary-card,
.monitor-advice-panel,
.monitor-facts-panel,
.monitor-side-panel,
.monitor-empty
  min-width 0
  border 1px solid #d8e2ef
  border-radius 8px
  background #ffffff
  box-shadow 0 10px 24px rgba(15, 23, 42, 0.055)

.monitor-report-panel
  padding 1.2rem 1.35rem
  border-color #b9d5f8
  background #f7fbff

.monitor-report-panel__heading
  display flex
  align-items flex-start
  justify-content space-between
  gap 1rem

.monitor-report-panel h2
  max-width 46rem
  margin-top 0.45rem
  color #0f1f35
  font-size 1.3rem
  line-height 1.45
  letter-spacing 0

.monitor-report-panel__meta
  margin-top 0.85rem !important
  color #64748b
  font-size 0.82rem

.monitor-report-status
  flex 0 0 auto
  padding 0.36rem 0.62rem
  border-radius 999px
  color #166534
  background #dcfce7
  font-size 0.75rem
  font-weight 700
  white-space nowrap

.monitor-report-status--rules
  color #92400e
  background #fef3c7

.monitor-report-status--none
  color #475569
  background #e2e8f0

.monitor-summary-grid
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 0.75rem

.monitor-summary-card
  display flex
  flex-direction column
  gap 0.3rem
  min-height 7.2rem
  padding 0.9rem
  border-top 3px solid #94a3b8

.monitor-summary-card span
  color #64748b
  font-size 0.82rem
  font-weight 700

.monitor-summary-card strong
  color #0f1f35
  font-size 1.55rem
  line-height 1.2

.monitor-summary-card small
  color #64748b
  font-size 0.75rem

.monitor-summary-card em
  color #334155
  font-size 0.75rem
  font-style normal

.monitor-summary-card--teal
  border-top-color #0f766e
.monitor-summary-card--amber
  border-top-color #d97706
.monitor-summary-card--blue
  border-top-color #2563eb
.monitor-summary-card--rose
  border-top-color #e11d48
.monitor-summary-card--green
  border-top-color #16a34a

.monitor-report-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.75rem

.monitor-advice-panel
  padding 1rem
  border-top 3px solid #2563eb

.monitor-advice-panel--nutrition
  border-top-color #16a34a
.monitor-advice-panel--recovery
  border-top-color #7c3aed
.monitor-advice-panel--other
  border-top-color #d97706

.monitor-section-heading h2
  margin-top 0.34rem
  color #0f1f35
  font-size 1.02rem
  line-height 1.25
  letter-spacing 0

.monitor-advice-summary
  margin-top 0.85rem !important
  color #334155
  font-size 0.9rem
  line-height 1.7

.monitor-advice-list
  margin 0.8rem 0 0
  padding-left 1.15rem
  color #0f1f35
  font-size 0.85rem
  line-height 1.7

.monitor-advice-list li + li
  margin-top 0.32rem

.monitor-facts-layout
  display grid
  grid-template-columns minmax(0, 1.6fr) minmax(15rem, 0.8fr)
  gap 0.75rem

.monitor-facts-panel,
.monitor-side-panel
  padding 1rem

.monitor-facts-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem 1.35rem
  margin-top 1rem

.monitor-fact-group h3
  color #64748b
  font-size 0.8rem
  font-weight 700

.monitor-fact-row
  display flex
  align-items baseline
  justify-content space-between
  gap 0.75rem
  padding 0.48rem 0
  border-bottom 1px solid #eef2f7
  font-size 0.8rem

.monitor-fact-row span
  color #64748b

.monitor-fact-row strong
  color #0f1f35
  text-align right

.monitor-quality-value
  display flex
  align-items baseline
  gap 0.55rem
  margin-top 1rem

.monitor-quality-value strong
  color #0f766e
  font-size 1.65rem

.monitor-quality-value span
  color #64748b
  font-size 0.78rem

.monitor-quality-bar
  height 0.42rem
  margin-top 0.7rem
  overflow hidden
  border-radius 999px
  background #e2e8f0

.monitor-quality-bar span
  display block
  height 100%
  border-radius inherit
  background #0f766e

.monitor-side-panel > p
  margin-top 0.75rem !important
  color #64748b
  font-size 0.8rem
  line-height 1.6

.monitor-alerts
  display flex
  flex-direction column
  gap 0.4rem
  margin-top 0.9rem

.monitor-alerts span
  padding 0.52rem 0.62rem
  border-left 3px solid #f59e0b
  background #fffbeb
  color #92400e
  font-size 0.78rem
  line-height 1.45

.monitor-empty
  padding 2.5rem 1.5rem
  text-align center

.monitor-empty h1
  margin-top 0.55rem
  color #0f1f35
  font-size 1.35rem
  letter-spacing 0

.monitor-empty p
  margin-top 0.8rem !important
  color #64748b

@media (max-width: 900px)
  .monitor-summary-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

  .monitor-facts-layout
    grid-template-columns 1fr

@media (max-width: 640px)
  .monitor-page
    gap 0.75rem

  .monitor-header,
  .monitor-report-panel__heading
    flex-direction column
    align-items flex-start

  .monitor-header__meta
    justify-content flex-start

  .monitor-summary-grid,
  .monitor-report-grid,
  .monitor-facts-grid
    grid-template-columns 1fr

  .monitor-summary-card strong
    font-size 1.35rem
