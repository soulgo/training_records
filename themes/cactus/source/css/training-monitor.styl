.monitor-page
  margin-top 1.1rem
  display flex
  flex-direction column
  gap 1rem
  color #172033

.monitor-page h1,
.monitor-page h2,
.monitor-page p
  margin 0

.monitor-header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  padding-bottom 0.75rem
  border-bottom 1px solid #d8e2ef

.monitor-header h1
  margin-top 0.28rem
  color #0f1f35
  font-size 1.52rem
  line-height 1.18
  letter-spacing 0

.monitor-eyebrow
  display block
  color #2563eb
  font-size 0.72rem
  font-weight 800
  line-height 1

.monitor-header__meta
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 0.45rem
  color #64748b
  font-size 0.84rem

.monitor-header__meta span
  display inline-flex
  align-items center
  gap 0.35rem
  min-height 2rem
  padding 0.34rem 0.58rem
  border 1px solid #d8e2ef
  border-radius 999px
  background #ffffff

.monitor-header__meta strong
  color #111827

.monitor-progress-grid,
.monitor-snapshot-grid
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 0.75rem

.monitor-progress-card,
.monitor-mini-card,
.monitor-chart-card,
.monitor-panel
  min-width 0
  border 1px solid #d8e2ef
  border-radius 8px
  background #ffffff
  box-shadow 0 10px 24px rgba(15, 23, 42, 0.055)

.monitor-progress-card
  display flex
  flex-direction column
  justify-content space-between
  min-height 8.35rem
  padding 0.88rem
  overflow hidden

.monitor-progress-card__top,
.monitor-progress-card__bottom
  display flex
  align-items flex-start
  justify-content space-between
  gap 0.6rem
  min-width 0

.monitor-progress-card__top span,
.monitor-progress-card__bottom span,
.monitor-mini-card span,
.monitor-stat span
  color #64748b
  font-size 0.78rem
  line-height 1.35

.monitor-progress-card__top strong
  color #0f172a
  font-size 1.18rem
  line-height 1.22
  text-align right

.monitor-progress-card__bottom strong
  color #334155
  font-size 0.8rem
  line-height 1.35
  text-align right

.monitor-progress-card__top strong,
.monitor-progress-card__bottom strong,
.monitor-progress-card__top span,
.monitor-progress-card__bottom span
  min-width 0
  overflow-wrap anywhere

.monitor-progress-card__bar,
.monitor-quality-meter
  height 0.5rem
  overflow hidden
  border-radius 999px
  background #e6edf5

.monitor-progress-card__bar
  margin 0.84rem 0

.monitor-progress-card__bar span,
.monitor-quality-meter span
  display block
  height 100%
  border-radius inherit
  background #2563eb

.monitor-progress-card--teal .monitor-progress-card__bar span
  background #0f766e

.monitor-progress-card--amber .monitor-progress-card__bar span
  background #d97706

.monitor-progress-card--blue .monitor-progress-card__bar span
  background #2563eb

.monitor-progress-card--rose .monitor-progress-card__bar span
  background #e11d48

.monitor-progress-card--green .monitor-progress-card__bar span
  background #16a34a

.monitor-mini-card
  min-height 5.2rem
  padding 0.78rem 0.84rem

.monitor-mini-card strong
  display block
  margin-top 0.24rem
  color #0f172a
  font-size 1.08rem
  line-height 1.22
  overflow-wrap anywhere

.monitor-mini-card small,
.monitor-stat small
  display block
  margin-top 0.22rem
  color #7c8ca3
  font-size 0.72rem
  line-height 1.35

.monitor-section-heading
  display flex
  flex-direction column
  gap 0.28rem
  margin-bottom 0.68rem

.monitor-section-heading h2
  color #0f1f35
  font-size 1.02rem
  line-height 1.25
  letter-spacing 0

.monitor-trend-grid,
.monitor-detail-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.82rem

.monitor-chart-card
  position relative
  min-height 20rem
  padding 0.88rem

.monitor-chart-card__heading
  display flex
  align-items flex-start
  justify-content space-between
  gap 1rem
  min-height 3rem
  margin-bottom 0.58rem

.monitor-chart-card__heading h2
  margin 0
  color #0f1f35
  font-size 0.96rem
  line-height 1.25

.monitor-chart-card__subtitle
  display block
  margin-top 0.18rem
  color #64748b
  font-size 0.76rem
  line-height 1.35

.monitor-chart-card canvas
  width 100% !important
  height 15.1rem !important

.monitor-chart-legend
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 0.34rem 0.42rem
  min-width 9rem
  max-width 15rem
  color #475569
  font-size 0.7rem
  line-height 1.2

.monitor-chart-legend__item
  display inline-flex
  align-items center
  justify-content flex-end
  gap 0.28rem
  min-height 1.35rem
  max-width 100%
  padding 0.12rem 0.4rem
  border 1px solid #e2e8f0
  border-radius 999px
  background #f8fafc

.monitor-chart-legend__swatch
  width 0.54rem
  height 0.54rem
  flex 0 0 auto
  border-radius 999px
  background var(--legend-color, currentColor)

.monitor-chart-legend__label
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.monitor-panel
  padding 0.9rem

.monitor-metric-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 0.4rem 0.75rem

.monitor-metric-grid--compact
  grid-template-columns repeat(2, minmax(0, 1fr))

.monitor-stat
  min-width 0
  padding 0.1rem 0 0.58rem
  border-bottom 1px solid #edf2f7

.monitor-stat strong
  display block
  margin-top 0.2rem
  color #0f172a
  font-size 1rem
  line-height 1.22
  overflow-wrap anywhere

.monitor-breakdown
  display flex
  flex-direction column
  gap 0.5rem
  margin-top 0.75rem

.monitor-breakdown__row
  display grid
  grid-template-columns minmax(4.5rem, 0.9fr) minmax(6rem, 2fr) auto
  align-items center
  gap 0.55rem
  color #475569
  font-size 0.78rem

.monitor-breakdown__row > div
  height 0.45rem
  overflow hidden
  border-radius 999px
  background #e6edf5

.monitor-breakdown__row > div span
  display block
  height 100%
  border-radius inherit
  background #0f766e

.monitor-breakdown__row strong
  color #0f172a
  font-size 0.8rem

.monitor-quality-meter
  margin-bottom 0.75rem

.monitor-quality-meter span
  background #16a34a

.monitor-panel p
  margin-top 0.66rem
  color #475569
  font-size 0.84rem
  line-height 1.55

.monitor-panel ul
  display flex
  flex-direction column
  gap 0.5rem
  margin 0
  padding 0
  list-style none

.monitor-panel li
  position relative
  padding 0.58rem 0.7rem 0.58rem 1.9rem
  border 1px solid #fee2e2
  border-radius 8px
  background #fff7f7
  color #7f1d1d
  font-size 0.84rem
  line-height 1.45

.monitor-panel li:before
  content "!"
  position absolute
  left 0.68rem
  top 0.58rem
  display inline-flex
  align-items center
  justify-content center
  width 0.86rem
  height 0.86rem
  border-radius 999px
  background #ef4444
  color #ffffff
  font-size 0.64rem
  font-weight 800
  line-height 1

.monitor-empty
  padding 1rem
  border 1px solid #d8e2ef
  border-radius 8px
  background #ffffff
  color #64748b

@media (max-width: 1080px)
  .monitor-progress-grid,
  .monitor-snapshot-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

  .monitor-trend-grid,
  .monitor-detail-grid
    grid-template-columns 1fr

@media (max-width: 640px)
  .monitor-header
    align-items stretch
    flex-direction column

  .monitor-header__meta
    justify-content flex-start

  .monitor-progress-grid,
  .monitor-snapshot-grid,
  .monitor-metric-grid,
  .monitor-metric-grid--compact
    grid-template-columns 1fr

  .monitor-chart-card__heading
    flex-direction column

  .monitor-chart-legend
    align-items flex-start
    justify-content flex-start
    min-width 0
    max-width 100%

  .monitor-breakdown__row
    grid-template-columns minmax(4.5rem, 1fr) minmax(5rem, 1.6fr) auto
