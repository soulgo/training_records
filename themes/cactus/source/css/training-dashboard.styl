.dashboard-page
  margin-top 1.15rem
  display flex
  flex-direction column
  gap 1.15rem
  color #0f172a

.dashboard-page p
  text-align start

.dashboard-page h2
  margin 0
  font-size 1.18rem
  line-height 1.2
  color #10233f

.dashboard-note
  margin-top 0.15rem
  padding 1rem 1.05rem
  border-radius 18px
  background #ffffff
  color #52607a
  font-size 0.93rem
  line-height 1.72
  border 1px solid #e2e8f0
  box-shadow 0 10px 24px rgba(15, 23, 42, 0.04)

.dashboard-note p
  margin 0

.dashboard-section__header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 0.95rem

.dashboard-section__eyebrow
  display inline-flex
  align-items center
  margin-bottom 0.35rem
  color #7b879c
  font-size 0.76rem
  font-weight 600
  line-height 1
  letter-spacing 0.08em
  text-transform uppercase

.dashboard-overview
  display grid
  grid-template-columns minmax(0, 1.35fr) minmax(0, 2fr)
  gap 1rem
  align-items stretch

.overview-card
  position relative
  display flex
  flex-direction column
  justify-content space-between
  min-height 100%
  padding 1.3rem
  border-radius 28px
  background linear-gradient(160deg, #ffffff 0%, #f4fbff 62%, #ecfeff 100%)
  border 1px solid rgba(125, 211, 252, 0.22)
  box-shadow 0 28px 64px rgba(15, 23, 42, 0.08)
  overflow hidden

.overview-card:before
  content ""
  position absolute
  inset auto -12% -28% auto
  width 16rem
  height 16rem
  border-radius 50%
  background radial-gradient(circle, rgba(125, 211, 252, 0.2), rgba(125, 211, 252, 0))
  pointer-events none

.overview-card__header,
.overview-card__meta,
.overview-card__stats
  position relative
  z-index 1

.overview-card__header strong
  display block
  margin-top 0.15rem
  color #0b3954
  font-size clamp(2rem, 4vw, 3rem)
  line-height 0.98
  letter-spacing 0

.overview-card__header p
  margin 0.65rem 0 0
  max-width 20rem
  color #527287
  font-size 0.97rem
  line-height 1.6

.overview-card__meta
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.75rem
  margin-top 1.35rem

.overview-card__meta-item
  padding 0.85rem 0.95rem
  border-radius 18px
  background rgba(255, 255, 255, 0.7)
  border 1px solid rgba(148, 163, 184, 0.12)
  backdrop-filter blur(10px)

.overview-card__meta-item span
  display block
  color #7b879c
  font-size 0.76rem
  line-height 1.3

.overview-card__meta-item strong
  display block
  margin-top 0.28rem
  color #17324d
  font-size 1rem
  line-height 1.4

.overview-card__stats
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.8rem
  margin-top 1.1rem

.overview-card__stat
  padding-top 0.9rem
  border-top 1px solid rgba(148, 163, 184, 0.18)

.overview-card__stat span
  display block
  color #6d7f92
  font-size 0.8rem

.overview-card__stat strong
  display block
  margin-top 0.3rem
  color #102a43
  font-size 1.4rem
  line-height 1.1

.overview-card__stat small
  display block
  margin-top 0.35rem
  color #7b879c
  font-size 0.8rem
  line-height 1.45

.hero-metrics
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.hero-card,
.metric-card,
.chart-card
  border-radius 24px
  background rgba(255, 255, 255, 0.92)
  border 1px solid rgba(148, 163, 184, 0.12)
  box-shadow 0 18px 44px rgba(15, 23, 42, 0.06)

.hero-card,
.metric-card
  display flex
  flex-direction column
  min-height 100%
  padding 1.2rem

.hero-label,
.metric-title
  display block
  margin-bottom 0.75rem
  color #6b7a90
  font-size 0.82rem
  font-weight 600
  line-height 1.2
  letter-spacing 0.04em
  text-transform uppercase

.metric-value
  display flex
  align-items flex-end
  gap 0.45rem
  min-height 3.8rem
  color #15253f

.metric-value--compact
  align-items center
  min-height 3rem

.metric-value--composite
  align-items baseline
  gap 0.55rem
  flex-wrap wrap

.metric-value__pair
  display inline-flex
  align-items baseline
  gap 0.32rem

.metric-value__number
  font-size clamp(2.05rem, 3vw, 2.7rem)
  font-weight 700
  line-height 1
  letter-spacing 0

.metric-value--compact .metric-value__number
  font-size clamp(1.8rem, 2.5vw, 2.2rem)

.metric-value__unit,
.metric-value__separator
  color #617086
  font-size 1rem
  font-weight 600
  line-height 1.4

.metric-value__separator
  padding-bottom 0.2rem

.hero-card__meta,
.metric-card__meta
  margin-top 0.9rem

.metric-meta
  display flex
  align-items baseline
  justify-content space-between
  gap 0.75rem
  color #6d7f92
  font-size 0.92rem
  line-height 1.45

.metric-meta strong
  color #334e68
  font-size 0.96rem
  font-weight 600
  text-align right

.hero-card__comparison,
.metric-card__comparison
  margin-top auto
  padding-top 1rem

.comparison-pill
  position relative
  display grid
  grid-template-columns auto minmax(0, 1fr)
  align-items center
  column-gap 0.58rem
  row-gap 0.42rem
  min-height 3.2rem
  padding 0.68rem 0.78rem 0.62rem 0.9rem
  border 1px solid rgba(148, 163, 184, 0.22)
  border-radius 15px
  background #f8fafc
  box-shadow inset 3px 0 0 currentColor, 0 8px 18px rgba(15, 23, 42, 0.04)

.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__summary
  display grid
  grid-template-columns auto auto
  align-items center
  gap 0.35rem
  min-width 0

.comparison-pill__arrow
  display inline-flex
  align-items center
  justify-content center
  width 1.45rem
  height 1.45rem
  border-radius 999px
  background rgba(255, 255, 255, 0.78)
  box-shadow 0 0 0 1px rgba(255, 255, 255, 0.65)
  font-size 0.82rem
  font-weight 700
  line-height 1

.comparison-pill__summary > span:nth-child(2)
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__label
  color #1f344d
  font-size 0.88rem
  font-weight 700
  line-height 1.2
  white-space nowrap

.comparison-pill__value
  justify-self start
  color #13233c
  font-size 1.05rem
  font-weight 800
  font-variant-numeric tabular-nums
  line-height 1
  white-space nowrap

.comparison-pill__meter
  display block
  grid-column 1 / -1
  position relative
  width 100%
  height 0.34rem
  border-radius 999px
  background rgba(255, 255, 255, 0.62)
  overflow hidden

.comparison-pill__meter--empty
  background rgba(255, 255, 255, 0.52)

.comparison-pill__meter-fill
  display block
  height 100%
  border-radius inherit
  background currentColor
  opacity 0.9

.comparison-pill--up
  color #b45309
  background #fff3e0
  border-color rgba(180, 83, 9, 0.28)

.comparison-pill--down
  color #047857
  background #e4f7ee
  border-color rgba(4, 120, 87, 0.28)

.comparison-pill--flat,
.comparison-pill--neutral
  color #475569
  background #eef2f7
  border-color rgba(71, 85, 105, 0.2)

.dashboard-charts,
.metric-grid,
.daily-section
  display block

.metric-grid__cards
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 1rem

.chart-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.chart-card
  padding 1.15rem 1.15rem 1rem

.chart-card--wide
  min-height 21rem

.chart-heading
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 1rem

.chart-heading h2
  margin 0

.chart-heading span
  display block
  margin-top 0.28rem
  color #7b879c
  font-size 0.88rem

.chart-card canvas
  width 100%
  height 240px !important

.daily-section__heading
  align-items center
  margin-bottom 1rem

.daily-section__meta
  display flex
  align-items center
  gap 0.7rem
  flex-wrap wrap
  justify-content flex-end

.daily-section__status
  padding 0.28rem 0.72rem
  border-radius 999px
  background #f8fafc
  border 1px solid #e2e8f0
  color #64748b
  font-size 0.84rem
  line-height 1.2

.daily-section__pager
  display inline-flex
  align-items center
  padding 0.2rem
  border-radius 999px
  border 1px solid #e2e8f0
  background rgba(248, 250, 252, 0.96)
  box-shadow 0 10px 24px rgba(15, 23, 42, 0.05)

.daily-section__nav
  border 0
  border-radius 999px
  padding 0.42rem 0.9rem
  background transparent
  color #475569
  font-size 0.86rem
  font-weight 600
  line-height 1
  cursor pointer
  transition background-color 0.2s ease, color 0.2s ease, transform 0.2s ease

.daily-section__nav:hover:not(:disabled)
  background #e2e8f0
  color #0f172a
  transform translateY(-1px)

.daily-section__nav:disabled
  color #94a3b8
  cursor default

.daily-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(260px, 1fr))
  gap 0.9rem

.day-card
  padding 1rem
  border-radius 16px
  background linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)
  border 1px solid #e2e8f0
  display flex
  flex-direction column

.day-card__header
  display flex
  justify-content space-between
  gap 1rem
  align-items baseline
  margin-bottom 0.75rem

.day-card__header h3
  margin 0
  font-size 1.05rem

.day-card__header span
  color #0f766e
  font-weight 600

.day-card__stats
  list-style none
  padding 0
  margin 0 0 0.9rem

.day-card__stats li
  display flex
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.35rem
  color #475569

.day-card__tags
  display flex
  flex-wrap wrap
  gap 0.45rem

.day-card__tags span
  padding 0.3rem 0.55rem
  border-radius 999px
  background #e2e8f0
  color #334155
  font-size 0.85rem

.dashboard-empty
  padding 1.25rem
  border-radius 24px
  background #fff7ed
  color #9a3412
  border 1px solid #fdba74

@media (max-width: 1180px)
  .dashboard-overview
    grid-template-columns 1fr

  .hero-metrics
    grid-template-columns repeat(2, minmax(0, 1fr))

  .metric-grid__cards
    grid-template-columns repeat(2, minmax(0, 1fr))

  .daily-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 860px)
  .dashboard-page
    gap 1.2rem

  .hero-metrics,
  .metric-grid__cards,
  .chart-grid,
  .daily-grid
    grid-template-columns 1fr

  .overview-card__meta,
  .overview-card__stats,
  .day-card__stats
    grid-template-columns 1fr

  .chart-card--wide
    min-height auto

  .chart-card canvas
    height 220px !important

  .comparison-pill
    grid-template-columns auto 1fr

  .comparison-pill__meter
    grid-column 1 / -1

  .comparison-pill__value
    text-align left

@media (max-width: 640px)
  .dashboard-page
    margin-top 1.2rem

  .overview-card,
  .hero-card,
  .metric-card,
  .chart-card
    padding 1rem
    border-radius 22px

  .overview-card__header strong
    font-size 2.15rem

  .metric-value
    min-height auto

  .metric-value__number
    font-size 1.9rem

  .metric-value--compact .metric-value__number
    font-size 1.7rem

  .metric-meta
    flex-direction column
    align-items flex-start

  .chart-heading,
  .daily-section__heading
    align-items flex-start
    flex-direction column

  .daily-section__meta
    width 100%
    justify-content space-between

  .daily-section__pager
    width 100%
    justify-content space-between

  .daily-section__nav
    flex 1

  .day-card__header
    flex-direction column
