.dashboard-page
  margin-top 1.25rem
  display flex
  flex-direction column
  gap 1.2rem
  color #12314b

.dashboard-page p
  text-align start

.dashboard-page h1,
.dashboard-page h2,
.dashboard-page h3,
.dashboard-page p
  margin 0

.dashboard-page h2
  font-size 1.14rem
  line-height 1.2
  color #163456

.dashboard-note
  margin-top 0.2rem
  padding 1rem 1.05rem
  border-radius 18px
  background #ffffff
  color #607089
  font-size 0.93rem
  line-height 1.72
  border 1px solid #dce7f2
  box-shadow 0 12px 28px rgba(18, 49, 75, 0.05)

.dashboard-note p
  margin 0

.dashboard-section__header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 0.9rem

.dashboard-section__eyebrow
  display inline-flex
  align-items center
  margin-bottom 0.35rem
  color #5f7896
  font-size 0.75rem
  font-weight 700
  line-height 1
  letter-spacing 0.08em
  text-transform uppercase

.dashboard-overview
  display grid
  grid-template-columns minmax(0, 1.38fr) minmax(0, 1.62fr)
  gap 1rem
  align-items stretch

.overview-card,
.hero-card,
.metric-card,
.chart-card,
.day-card
  border-radius 20px
  background #ffffff
  border 1px solid #dbe7f3
  box-shadow 0 10px 24px rgba(18, 49, 75, 0.05)

.overview-card
  position relative
  display flex
  flex-direction column
  justify-content space-between
  min-height 100%
  padding 1.25rem
  overflow hidden
  background linear-gradient(180deg, #ffffff 0%, #f7fbff 100%)

.overview-card:before
  content ""
  position absolute
  inset auto -10% -25% auto
  width 14rem
  height 14rem
  border-radius 50%
  background radial-gradient(circle, rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0))
  pointer-events none

.overview-card__header,
.overview-card__meta,
.overview-card__stats
  position relative
  z-index 1

.overview-card__header strong
  display block
  margin-top 0.15rem
  color #123a5f
  font-size clamp(1.95rem, 3.5vw, 2.7rem)
  line-height 1

.overview-card__header p
  margin-top 0.6rem
  max-width 20rem
  color #5d758b
  font-size 0.95rem
  line-height 1.6

.overview-card__meta
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.75rem
  margin-top 1.15rem

.overview-card__meta-item
  padding 0.82rem 0.9rem
  border-radius 16px
  background rgba(248, 250, 252, 0.92)
  border 1px solid #e2e8f0

.overview-card__meta-item span
  display block
  color #7b879c
  font-size 0.75rem
  line-height 1.3

.overview-card__meta-item strong
  display block
  margin-top 0.25rem
  color #17324d
  font-size 0.98rem
  line-height 1.4

.overview-card__stats
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.8rem
  margin-top 1rem

.overview-card__stat
  padding-top 0.85rem
  border-top 1px solid rgba(148, 163, 184, 0.18)

.overview-card__stat span
  display block
  color #6d7f92
  font-size 0.78rem

.overview-card__stat strong
  display block
  margin-top 0.28rem
  color #102a43
  font-size 1.3rem
  line-height 1.1

.overview-card__stat small
  display block
  margin-top 0.32rem
  color #7b879c
  font-size 0.78rem
  line-height 1.45

.hero-metrics
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.hero-card,
.metric-card
  display flex
  flex-direction column
  min-height 100%
  padding 1.15rem

.hero-label,
.metric-title
  display block
  margin-bottom 0.7rem
  color #6b7a90
  font-size 0.78rem
  font-weight 700
  line-height 1.2
  letter-spacing 0.05em
  text-transform uppercase

.metric-value
  display flex
  align-items flex-end
  gap 0.4rem
  min-height 3.5rem
  color #15253f

.metric-value--compact
  align-items center
  min-height 2.85rem

.metric-value__number
  font-size clamp(1.9rem, 2.7vw, 2.45rem)
  font-weight 700
  line-height 1
  letter-spacing -0.02em
  font-variant-numeric tabular-nums

.metric-value--compact .metric-value__number
  font-size clamp(1.6rem, 2.2vw, 1.95rem)

.metric-value__unit,
.metric-value__separator
  color #617086
  font-size 0.92rem
  font-weight 600
  line-height 1.3

.metric-value__separator
  padding-bottom 0.2rem

.hero-card__meta,
.metric-card__meta
  margin-top 0.85rem

.metric-meta
  display flex
  align-items baseline
  justify-content space-between
  gap 0.75rem
  color #6d7f92
  font-size 0.88rem
  line-height 1.45

.metric-meta strong
  color #334e68
  font-size 0.9rem
  font-weight 600
  text-align right

.hero-card__comparison,
.metric-card__comparison
  margin-top auto
  padding-top 0.9rem

.comparison-pill
  position relative
  display grid
  grid-template-columns auto minmax(0, 1fr)
  align-items center
  column-gap 0.55rem
  row-gap 0.35rem
  min-height 3rem
  padding 0.62rem 0.72rem 0.56rem 0.82rem
  border 1px solid rgba(148, 163, 184, 0.2)
  border-radius 14px
  background #f8fafc
  box-shadow inset 2px 0 0 currentColor

.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__summary
  display grid
  grid-template-columns auto auto
  align-items center
  gap 0.3rem
  min-width 0

.comparison-pill__arrow
  display inline-flex
  align-items center
  justify-content center
  width 1.35rem
  height 1.35rem
  border-radius 999px
  background rgba(255, 255, 255, 0.82)
  box-shadow 0 0 0 1px rgba(255, 255, 255, 0.8)
  font-size 0.8rem
  font-weight 700
  line-height 1

.comparison-pill__summary > span:nth-child(2)
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__label
  color #1f344d
  font-size 0.84rem
  font-weight 700
  line-height 1.2
  white-space nowrap

.comparison-pill__value
  justify-self start
  color #13233c
  font-size 0.98rem
  font-weight 800
  font-variant-numeric tabular-nums
  line-height 1
  white-space nowrap

.comparison-pill__meter
  display block
  grid-column 1 / -1
  position relative
  width 100%
  height 0.32rem
  border-radius 999px
  background rgba(255, 255, 255, 0.62)
  overflow hidden

.comparison-pill__meter--empty
  background rgba(255, 255, 255, 0.55)

.comparison-pill__meter-fill
  display block
  height 100%
  border-radius inherit
  background currentColor
  opacity 0.92

.comparison-pill--up
  color #c2410c
  background #fff4eb
  border-color rgba(194, 65, 12, 0.18)

.comparison-pill--down
  color #0f766e
  background #ecfdf8
  border-color rgba(15, 118, 110, 0.18)

.comparison-pill--flat,
.comparison-pill--neutral
  color #5c7087
  background #eef3f8
  border-color rgba(92, 112, 135, 0.16)

.dashboard-charts,
.metric-grid,
.daily-section
  display block

.metric-grid__cards
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 1rem

.chart-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.chart-card
  padding 1.05rem 1.05rem 0.95rem

.chart-card--wide
  min-height 21rem

.chart-heading
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 0.9rem

.chart-heading h2
  margin 0

.chart-heading span
  display block
  margin-top 0.28rem
  color #7b879c
  font-size 0.86rem

.chart-card canvas
  width 100%
  height 240px !important

.daily-section__heading
  align-items center
  margin-bottom 1rem

.daily-section__meta
  display flex
  align-items center
  gap 0.7rem
  flex-wrap wrap
  justify-content flex-end

.daily-section__status
  padding 0.28rem 0.72rem
  border-radius 999px
  background #f8fafc
  border 1px solid #e2e8f0
  color #64748b
  font-size 0.84rem
  line-height 1.2

.daily-section__pager
  display inline-flex
  align-items center
  padding 0.2rem
  border-radius 999px
  border 1px solid #e2e8f0
  background rgba(248, 250, 252, 0.96)
  box-shadow 0 10px 24px rgba(15, 23, 42, 0.05)

.daily-section__nav
  border 0
  border-radius 999px
  padding 0.42rem 0.9rem
  background transparent
  color #475569
  font-size 0.86rem
  font-weight 600
  line-height 1
  cursor pointer
  transition background-color 0.2s ease, color 0.2s ease, transform 0.2s ease

.daily-section__nav:hover:not(:disabled)
  background #e2e8f0
  color #0f172a
  transform translateY(-1px)

.daily-section__nav:disabled
  color #94a3b8
  cursor default

.daily-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(260px, 1fr))
  gap 0.9rem

.day-card
  padding 1rem
  border-radius 16px
  background linear-gradient(180deg, #ffffff 0%, #f8fafc 100%)
  border 1px solid #e2e8f0
  display flex
  flex-direction column

.day-card__header
  display flex
  justify-content space-between
  gap 1rem
  align-items baseline
  margin-bottom 0.75rem

.day-card__header h3
  margin 0
  font-size 1.05rem

.day-card__header span
  color #0f766e
  font-weight 600

.day-card__stats
  list-style none
  padding 0
  margin 0 0 0.9rem

.day-card__stats li
  display flex
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.35rem
  color #475569

.day-card__tags
  display flex
  flex-wrap wrap
  gap 0.45rem

.day-card__tags span
  padding 0.3rem 0.55rem
  border-radius 999px
  background #e2e8f0
  color #334155
  font-size 0.85rem

.dashboard-empty
  padding 1.25rem
  border-radius 24px
  background #fff7ed
  color #9a3412
  border 1px solid #fdba74

@media (max-width: 1180px)
  .dashboard-overview
    grid-template-columns 1fr

  .hero-metrics
    grid-template-columns repeat(2, minmax(0, 1fr))

  .metric-grid__cards
    grid-template-columns repeat(2, minmax(0, 1fr))

  .daily-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 860px)
  .dashboard-page
    gap 1rem

  .hero-metrics,
  .metric-grid__cards,
  .chart-grid,
  .daily-grid
    grid-template-columns 1fr

  .overview-card__meta,
  .overview-card__stats,
  .day-card__stats
    grid-template-columns 1fr

  .chart-card--wide
    min-height auto

  .chart-card canvas
    height 220px !important

  .comparison-pill
    grid-template-columns auto 1fr

  .comparison-pill__meter
    grid-column 1 / -1

  .comparison-pill__value
    text-align left

@media (max-width: 640px)
  .dashboard-page
    margin-top 1rem

  .overview-card,
  .hero-card,
  .metric-card,
  .chart-card,
  .day-card,
  .dashboard-note
    padding 1rem

  .overview-card__header strong
    font-size 2.05rem

  .metric-value
    min-height auto

  .metric-value__number
    font-size 1.8rem

  .metric-value--compact .metric-value__number
    font-size 1.55rem

  .metric-meta
    flex-direction column
    align-items flex-start

  .chart-heading,
  .daily-section__heading
    align-items flex-start
    flex-direction column

  .daily-section__meta
    width 100%
    justify-content space-between

  .daily-section__pager
    width 100%
    justify-content space-between

  .daily-section__nav
    flex 1

  .day-card__header
    flex-direction column
