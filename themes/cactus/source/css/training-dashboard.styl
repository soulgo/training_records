.dashboard-page
  position relative
  margin-top 1.25rem
  display flex
  flex-direction column
  gap 1.05rem
  color #0f2d4a
  background linear-gradient(180deg, #eef8ff 0%, #f8fbff 22%, #ffffff 100%)

.dashboard-page:before
  content ""
  position absolute
  inset 0
  pointer-events none
  background linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 18%)

.dashboard-page .overview-card,
.dashboard-page .hero-card,
.dashboard-page .metric-card,
.dashboard-page .chart-card,
.dashboard-page .day-card
  box-shadow 0 18px 48px rgba(30, 64, 175, 0.09)
  backdrop-filter blur(12px)

.dashboard-page .overview-card,
.dashboard-page .hero-card,
.dashboard-page .metric-card,
.dashboard-page .chart-card,
.dashboard-page .day-card
  background rgba(255, 255, 255, 0.88)
  border 1px solid rgba(191, 219, 254, 0.85)

.dashboard-page .overview-card:before
  background radial-gradient(circle, rgba(56, 189, 248, 0.22), rgba(56, 189, 248, 0))

.dashboard-page .hero-card:nth-child(1)
  background linear-gradient(180deg, #f7fbff 0%, #e8f4ff 100%)

.dashboard-page .hero-card:nth-child(2)
  background linear-gradient(180deg, #fff8f2 0%, #ffeeda 100%)

.dashboard-page .metric-card:nth-child(1)
  background linear-gradient(180deg, #f7fffd 0%, #e8fbf5 100%)

.dashboard-page .metric-card:nth-child(2)
  background linear-gradient(180deg, #f7fbff 0%, #edf2ff 100%)

.dashboard-page .metric-card:nth-child(3)
  background linear-gradient(180deg, #fffaf6 0%, #fff0e4 100%)

.dashboard-page .comparison-pill--up
  background linear-gradient(180deg, #fff4ec 0%, #ffe8d7 100%)

.dashboard-page .comparison-pill--down
  background linear-gradient(180deg, #ecfff9 0%, #dbfff3 100%)

.dashboard-page .comparison-pill--flat,
.dashboard-page .comparison-pill--neutral
  background linear-gradient(180deg, #f2f7ff 0%, #e7effb 100%)

.dashboard-page .day-card
  background linear-gradient(180deg, #ffffff 0%, #f3faff 100%)

.dashboard-page p
  text-align start

.dashboard-page h1,
.dashboard-page h2,
.dashboard-page h3,
.dashboard-page p
  margin 0

.dashboard-page h2
  font-size 1.14rem
  line-height 1.2
  color #153b5d

.dashboard-note
  margin-top 0.2rem
  padding 1rem 1.05rem
  border-radius 18px
  background #ffffff
  color #5f7088
  font-size 0.93rem
  line-height 1.72
  border 1px solid #d6e3f0
  box-shadow 0 12px 28px rgba(16, 37, 61, 0.06)

.dashboard-note p
  margin 0

.dashboard-section__header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 0.75rem

.dashboard-section__eyebrow
  display inline-flex
  align-items center
  margin-bottom 0.35rem
  color #2563eb
  font-size 0.75rem
  font-weight 800
  line-height 1
  letter-spacing 0.08em
  text-transform uppercase

.dashboard-overview
  display grid
  grid-template-columns minmax(0, 1.38fr) minmax(0, 1.62fr)
  gap 1rem
  align-items stretch

.overview-card,
.hero-card,
.metric-card,
.chart-card,
.day-card
  border-radius 20px
  background #ffffff
  border 1px solid #d9e6f2
  box-shadow 0 12px 28px rgba(16, 37, 61, 0.06)

.overview-card
  position relative
  display flex
  flex-direction column
  justify-content space-between
  min-height 100%
  padding 1.25rem
  overflow hidden
  background linear-gradient(180deg, #ffffff 0%, #f3f9ff 100%)

.overview-card:before
  content ""
  position absolute
  inset auto -10% -25% auto
  width 14rem
  height 14rem
  border-radius 50%
  background radial-gradient(circle, rgba(59, 130, 246, 0.16), rgba(59, 130, 246, 0))
  pointer-events none

.overview-card__header,
.overview-card__meta,
.overview-card__stats
  position relative
  z-index 1

.overview-card__header strong
  display block
  margin-top 0.15rem
  color #0b4a7a
  font-size clamp(1.95rem, 3.5vw, 2.7rem)
  line-height 1
  text-shadow 0 1px 0 rgba(255, 255, 255, 0.5)

.overview-card__header p
  margin-top 0.6rem
  max-width 20rem
  color #5a7288
  font-size 0.95rem
  line-height 1.6

.overview-card__meta
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.7rem
  margin-top 1rem

.overview-card__meta-item
  padding 0.82rem 0.9rem
  border-radius 16px
  background rgba(248, 250, 252, 0.96)
  border 1px solid #dde8f3

.overview-card__meta-item span
  display block
  color #6d7f92
  font-size 0.75rem
  line-height 1.3

undefined
.overview-card__stats
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.7rem
  margin-top 0.85rem
  min-width 0

.overview-card__meta-item,
.overview-card__stat
  min-width 0

.overview-card__meta-item strong,
.overview-card__stat strong,
.overview-card__stat small
  overflow hidden
  text-overflow ellipsis

.overview-card__stat
  padding-top 0.85rem
  border-top 1px solid rgba(148, 163, 184, 0.18)

.overview-card__stat span
  display block
  color #6d7f92
  font-size 0.78rem

.overview-card__stat strong
  display block
  margin-top 0.28rem
  color #102a43
  font-size 1.3rem
  line-height 1.1

.overview-card__stat small
  display block
  margin-top 0.32rem
  color #7b879c
  font-size 0.78rem
  line-height 1.45

.hero-metrics
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.8rem

.hero-card,
.metric-card
  display flex
  flex-direction column
  min-height 100%
  padding 1rem 1rem 0.95rem

.hero-label,
.metric-title
  display block
  margin-bottom 0.7rem
  color #58708b
  font-size 0.78rem
  font-weight 700
  line-height 1.2
  letter-spacing 0.05em
  text-transform uppercase

.metric-value
  display flex
  align-items flex-end
  flex-wrap wrap
  gap 0.28rem 0.35rem
  min-height 3.5rem
  color #12314d
  max-width 100%

.metric-value--compact
  align-items center
  min-height 2.85rem

.metric-value__number
  display inline-block
  min-width 0
  max-width 100%
  font-size clamp(1.75rem, 2.5vw, 2.3rem)
  font-weight 800
  line-height 1
  letter-spacing -0.03em
  font-variant-numeric tabular-nums
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.metric-value--compact .metric-value__number
  font-size clamp(1.45rem, 2vw, 1.78rem)

.metric-value__unit,
.metric-value__separator
  color #60758f
  font-size 0.92rem
  font-weight 600
  line-height 1.3
  white-space nowrap

.metric-value__separator
  padding-bottom 0.2rem

.hero-card__meta,
.metric-card__meta
  margin-top 0.85rem
  min-width 0

.metric-meta
  display flex
  align-items baseline
  justify-content space-between
  gap 0.75rem
  color #6d7f92
  font-size 0.88rem
  line-height 1.45
  min-width 0

.metric-meta strong
  color #2f4966
  font-size 0.9rem
  font-weight 600
  text-align right
  white-space nowrap
  flex-shrink 0

.hero-card__comparison,
.metric-card__comparison
  margin-top auto
  padding-top 0.9rem
  min-width 0

.comparison-pill
  position relative
  display grid
  grid-template-columns auto minmax(0, 1fr)
  align-items center
  column-gap 0.55rem
  row-gap 0.35rem
  min-height 3rem
  padding 0.62rem 0.72rem 0.56rem 0.82rem
  border 1px solid rgba(148, 163, 184, 0.2)
  border-radius 14px
  background #f8fafc
  box-shadow inset 2px 0 0 currentColor
  min-width 0
  overflow hidden

.comparison-pill__summary,
.comparison-pill__label,
.comparison-pill__value
  min-width 0

.comparison-pill__summary
  grid-template-columns auto minmax(0, 1fr)
  width 100%

.comparison-pill__label,
.comparison-pill__value
  overflow hidden
  text-overflow ellipsis

.sr-only
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__summary
  display grid
  grid-template-columns auto auto
  align-items center
  gap 0.3rem
  min-width 0

.comparison-pill__arrow
  display inline-flex
  align-items center
  justify-content center
  width 1.35rem
  height 1.35rem
  border-radius 999px
  background rgba(255, 255, 255, 0.82)
  box-shadow 0 0 0 1px rgba(255, 255, 255, 0.8)
  font-size 0.8rem
  font-weight 700
  line-height 1

.comparison-pill__summary > span:nth-child(2)
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.comparison-pill__label
  color #214261
  font-size 0.84rem
  font-weight 700
  line-height 1.2
  white-space nowrap

.comparison-pill__value
  justify-self start
  color #12314d
  font-size 0.98rem
  font-weight 800
  font-variant-numeric tabular-nums
  line-height 1
  white-space nowrap

.comparison-pill__meter
  display block
  grid-column 1 / -1
  position relative
  width 100%
  height 0.32rem
  border-radius 999px
  background rgba(255, 255, 255, 0.62)
  overflow hidden

.comparison-pill__meter--empty
  background rgba(255, 255, 255, 0.55)

.comparison-pill__meter-fill
  display block
  height 100%
  border-radius inherit
  background currentColor
  opacity 0.92

.comparison-pill--up
  color #ff6a00
  background #fff1e8
  border-color rgba(255, 106, 0, 0.2)

.comparison-pill--down
  color #00a37a
  background #e6fff7
  border-color rgba(0, 163, 122, 0.2)

.comparison-pill--flat,
.comparison-pill--neutral
  color #5c7087
  background #eef4fb
  border-color rgba(92, 112, 135, 0.16)

.dashboard-charts,
.metric-grid,
.daily-section
  display block

.metric-grid__cards
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 0.85rem

.chart-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 0.85rem

.chart-card
  padding 1rem 1rem 0.9rem

.chart-card--wide
  min-height 21rem

.chart-heading
  display flex
  align-items flex-start
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.55rem

.chart-heading h2
  margin 0

.chart-heading span
  display block
  margin-top 0.28rem
  color #7188a0
  font-size 0.86rem

.chart-legend
  display flex
  flex-wrap wrap
  justify-content flex-end
  gap 0.35rem
  margin-top 0.15rem
  min-height 2rem
  align-items flex-start

.chart-legend__item
  display inline-flex
  align-items center
  gap 0.45rem
  color #314b68
  font-size 0.84rem
  font-weight 700
  line-height 1
  white-space nowrap

.chart-legend__swatch
  display inline-block
  width 0.72rem
  height 0.72rem
  border-radius 999px
  background var(--legend-color, currentColor)
  box-shadow 0 0 0 2px rgba(255, 255, 255, 0.95)

.chart-legend__label
  overflow hidden
  text-overflow ellipsis

.chart-card canvas
  width 100%
  height 240px !important

.daily-section__heading
  align-items center
  margin-bottom 1rem

.daily-section__meta
  display flex
  align-items center
  gap 0.7rem
  flex-wrap wrap
  justify-content flex-end

.daily-section__status
  padding 0.28rem 0.72rem
  border-radius 999px
  background #f8fafc
  border 1px solid #dbe7f3
  color #5f7088
  font-size 0.84rem
  line-height 1.2

.daily-section__pager
  display inline-flex
  align-items center
  padding 0.2rem
  border-radius 999px
  border 1px solid #dbe7f3
  background rgba(248, 250, 252, 0.96)
  box-shadow 0 10px 24px rgba(16, 37, 61, 0.05)

.daily-section__nav
  border 0
  border-radius 999px
  padding 0.42rem 0.9rem
  background transparent
  color #475569
  font-size 0.86rem
  font-weight 600
  line-height 1
  cursor pointer
  transition background-color 0.2s ease, color 0.2s ease, transform 0.2s ease

.daily-section__nav:hover:not(:disabled)
  background #e2e8f0
  color #0f172a
  transform translateY(-1px)

.daily-section__nav:disabled
  color #94a3b8
  cursor default

.daily-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(260px, 1fr))
  gap 0.9rem

.day-card
  padding 1rem
  border-radius 16px
  background linear-gradient(180deg, #ffffff 0%, #f8fbff 100%)
  border 1px solid #dbe7f3
  display flex
  flex-direction column

.day-card__header
  display flex
  justify-content space-between
  gap 1rem
  align-items baseline
  margin-bottom 0.75rem

.day-card__header h3
  margin 0
  font-size 1.05rem
  color #14395b

.day-card__header span
  color #0f766e
  font-weight 600

.day-card__stats
  list-style none
  padding 0
  margin 0 0 0.9rem

.day-card__stats li
  display flex
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.35rem
  color #475569

.day-card__tags
  display flex
  flex-wrap wrap
  gap 0.45rem

.day-card__tags span
  padding 0.3rem 0.55rem
  border-radius 999px
  background #dceffd
  color #153a5c
  font-size 0.85rem

.dashboard-empty
  padding 1.25rem
  border-radius 24px
  background #fff7ed
  color #9a3412
  border 1px solid #fdba74

@media (max-width: 1180px)
  .dashboard-overview
    grid-template-columns 1fr

  .hero-metrics
    grid-template-columns repeat(2, minmax(0, 1fr))

  .metric-grid__cards
    grid-template-columns repeat(2, minmax(0, 1fr))

  .daily-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 860px)
  .dashboard-page
    gap 1rem

  .hero-metrics,
  .metric-grid__cards,
  .chart-grid,
  .daily-grid
    grid-template-columns 1fr

  .overview-card__meta,
  .overview-card__stats,
  .day-card__stats
    grid-template-columns 1fr

  .chart-card--wide
    min-height auto

  .chart-card canvas
    height 220px !important

  .comparison-pill
    grid-template-columns auto 1fr

  .comparison-pill__meter
    grid-column 1 / -1

  .comparison-pill__value
    text-align left

@media (max-width: 640px)
  .dashboard-page
    margin-top 1rem

  .overview-card,
  .hero-card,
  .metric-card,
  .chart-card,
  .day-card,
  .dashboard-note
    padding 1rem

  .overview-card__header strong
    font-size 2.05rem

  .metric-value
    min-height auto

  .metric-value__number
    font-size 1.8rem

  .metric-value--compact .metric-value__number
    font-size 1.55rem

  .metric-meta
    flex-direction column
    align-items flex-start

  .chart-heading,
  .daily-section__heading
    align-items flex-start
    flex-direction column

  .daily-section__meta
    width 100%
    justify-content space-between

  .daily-section__pager
    width 100%
    justify-content space-between

  .daily-section__nav
    flex 1

  .day-card__header
    flex-direction column
