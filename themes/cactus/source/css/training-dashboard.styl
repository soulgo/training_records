.dashboard-page
  margin-top 1rem
  display flex
  flex-direction column
  gap 1.1rem
  color #0f172a
  background #f8fafc

.dashboard-page p
  text-align start

.dashboard-page h1,
.dashboard-page h2,
.dashboard-page h3,
.dashboard-page p
  margin 0

.dashboard-note
  padding 1rem 1.1rem
  border-radius 16px
  background #ffffff
  color #64748b
  font-size 0.93rem
  line-height 1.7
  border 1px solid #e2e8f0
  box-shadow 0 6px 18px rgba(15, 23, 42, 0.04)

.dashboard-hero,
.dashboard-section,
.daily-section
  background transparent

.dashboard-hero
  display grid
  grid-template-columns minmax(0, 1.15fr) minmax(0, 1.25fr)
  gap 1rem
  align-items stretch

.dashboard-hero__intro
  padding 1.35rem 1.4rem
  border-radius 16px
  background #ffffff
  border 1px solid #e2e8f0
  box-shadow 0 6px 18px rgba(15, 23, 42, 0.04)

.dashboard-hero__topline
  display flex
  align-items flex-start
  justify-content space-between
  gap 1rem

.dashboard-kicker,
.dashboard-section__eyebrow
  display inline-flex
  align-items center
  color #64748b
  font-size 0.74rem
  font-weight 700
  line-height 1
  letter-spacing 0.08em
  text-transform uppercase

.dashboard-hero__meta
  display grid
  gap 0.5rem

.dashboard-hero__meta--inline
  grid-template-columns repeat(2, minmax(0, max-content))

.dashboard-hero__meta-item
  padding 0.55rem 0.75rem
  border-radius 12px
  background #f8fafc
  border 1px solid #e2e8f0

.dashboard-hero__meta-item--inline
  background transparent
  border-color transparent
  padding 0

.dashboard-hero__meta-item span
  display block
  color #64748b
  font-size 0.74rem

.dashboard-hero__meta-item strong
  display block
  margin-top 0.18rem
  color #0f172a
  font-size 0.92rem
  font-weight 700

.dashboard-hero__intro h1
  margin-top 0.8rem
  max-width 18ch
  color #0f172a
  font-size clamp(2rem, 3.4vw, 3.1rem)
  line-height 1.05
  letter-spacing -0.03em

.dashboard-hero__intro p
  margin-top 0.9rem
  max-width 40rem
  color #64748b
  font-size 0.98rem
  line-height 1.72

.dashboard-hero__metrics
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 1rem

.dashboard-strip
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 0.75rem

.dashboard-strip__item,
.hero-card,
.metric-card,
.chart-card,
.day-card
  border-radius 16px
  background #ffffff
  border 1px solid #e2e8f0
  box-shadow 0 6px 18px rgba(15, 23, 42, 0.04)

.dashboard-strip__item
  padding 0.9rem 1rem

.dashboard-strip__item span
  display block
  color #64748b
  font-size 0.77rem

.dashboard-strip__item strong
  display block
  margin-top 0.28rem
  color #0f172a
  font-size 1rem
  font-weight 700

.dashboard-strip__item--quiet
  background #fff

.dashboard-section__header
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 0.85rem

.dashboard-section__header--charts
  align-items flex-end

.dashboard-section__lede
  max-width 32rem
  color #64748b
  font-size 0.92rem
  line-height 1.65

.dashboard-section__eyebrow
  margin-bottom 0.35rem

.dashboard-section__header h2
  font-size 1.2rem
  line-height 1.2
  color #0f172a

.metric-grid__cards,
.chart-grid,
.daily-grid
  display grid
  gap 1rem

.metric-grid__cards--compact
  grid-template-columns repeat(5, minmax(0, 1fr))

.metric-grid__cards--training
  grid-template-columns repeat(4, minmax(0, 1fr))

.hero-card,
.metric-card,
.chart-card
  display flex
  flex-direction column
  min-height 100%
  padding 1.05rem

.day-card
  padding 1rem
  display flex
  flex-direction column

.metric-card__head
  display flex
  align-items flex-start
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.6rem

.hero-label,
.metric-title
  display block
  color #64748b
  font-size 0.76rem
  font-weight 700
  line-height 1.2
  letter-spacing 0.06em
  text-transform uppercase

.metric-value
  display flex
  align-items baseline
  gap 0.35rem
  min-height 3rem
  color #0f172a

.metric-value--compact
  min-height 2.45rem

.metric-value__number
  font-size clamp(1.75rem, 2.7vw, 2.45rem)
  font-weight 700
  line-height 1
  letter-spacing -0.03em
  font-variant-numeric tabular-nums

.metric-value--compact .metric-value__number
  font-size clamp(1.45rem, 2.1vw, 1.95rem)

.metric-value__unit,
.metric-value__separator
  color #64748b
  font-size 0.9rem
  font-weight 600
  line-height 1.3

.metric-card__meta,
.hero-card__meta
  margin-top 0.65rem

.metric-meta
  display flex
  align-items baseline
  justify-content space-between
  gap 0.75rem
  color #64748b
  font-size 0.88rem
  line-height 1.5

.metric-meta strong
  color #0f172a
  font-size 0.88rem
  font-weight 600
  text-align right

.hero-card__comparison,
.metric-card__comparison
  margin-top 0
  padding-top 0

.comparison-pill
  display inline-flex
  align-items center
  gap 0.2rem
  align-self flex-start
  padding 0
  border 0
  background transparent
  box-shadow none
  color #64748b
  font-size 0.8rem
  font-weight 700
  line-height 1
  min-height auto

.comparison-pill__summary,
.comparison-pill__meter
  display none

.comparison-pill__label,
.comparison-pill__value
  color inherit
  font-size inherit
  font-weight inherit
  line-height inherit

.comparison-pill--up
  color #16a34a

.comparison-pill--down
  color #dc2626

.comparison-pill--flat,
.comparison-pill--neutral
  color #64748b

.comparison-pill::before
  content ''

.dashboard-section--charts
  margin-top 0.15rem

.chart-grid
  grid-template-columns repeat(2, minmax(0, 1fr))

.chart-card--wide
  min-height 26rem

.chart-heading
  display flex
  align-items flex-end
  justify-content space-between
  gap 1rem
  margin-bottom 1rem

.chart-heading h2
  margin 0
  font-size 1rem
  color #0f172a

.chart-heading span
  display block
  margin-top 0.25rem
  color #64748b
  font-size 0.86rem

.chart-card canvas
  width 100%
  height 360px !important

.daily-section__heading
  align-items center
  margin-bottom 1rem

.daily-section__meta
  display flex
  align-items center
  gap 0.7rem
  flex-wrap wrap
  justify-content flex-end

.daily-section__status
  padding 0.3rem 0.7rem
  border-radius 999px
  background #fff
  border 1px solid #e2e8f0
  color #64748b
  font-size 0.84rem
  line-height 1.2

.daily-section__pager
  display inline-flex
  align-items center
  padding 0.2rem
  border-radius 999px
  border 1px solid #e2e8f0
  background #ffffff

.daily-section__nav
  border 0
  border-radius 999px
  padding 0.4rem 0.85rem
  background transparent
  color #475569
  font-size 0.86rem
  font-weight 600
  line-height 1
  cursor pointer

.daily-section__nav:hover:not(:disabled)
  background #f1f5f9
  color #0f172a

.daily-section__nav:disabled
  color #94a3b8
  cursor default

.daily-grid
  grid-template-columns repeat(auto-fit, minmax(250px, 1fr))

.day-card__header
  display flex
  justify-content space-between
  gap 1rem
  align-items baseline
  margin-bottom 0.7rem

.day-card__header h3
  margin 0
  font-size 1.02rem
  color #0f172a

.day-card__header span
  color #64748b
  font-weight 600

.day-card__stats
  list-style none
  padding 0
  margin 0

.day-card__stats li
  display flex
  justify-content space-between
  gap 0.75rem
  margin-bottom 0.35rem
  color #475569
  font-size 0.92rem

.day-card__tags
  display flex
  flex-wrap wrap
  gap 0.45rem
  margin-top 0.75rem

.day-card__tags span
  padding 0.28rem 0.55rem
  border-radius 999px
  background #f1f5f9
  color #334155
  font-size 0.82rem

.dashboard-empty
  padding 1.25rem
  border-radius 16px
  background #ffffff
  color #64748b
  border 1px solid #e2e8f0
  box-shadow 0 6px 18px rgba(15, 23, 42, 0.04)

@media (max-width: 1180px)
  .dashboard-hero
    grid-template-columns 1fr

  .dashboard-hero__metrics,
  .metric-grid__cards--compact
    grid-template-columns repeat(2, minmax(0, 1fr))

  .metric-grid__cards--training
    grid-template-columns repeat(2, minmax(0, 1fr))

  .dashboard-strip
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width: 860px)
  .dashboard-page
    gap 1rem

  .dashboard-hero__metrics,
  .metric-grid__cards--compact,
  .metric-grid__cards--training,
  .chart-grid,
  .daily-grid,
  .dashboard-strip
    grid-template-columns 1fr

  .chart-card--wide
    min-height auto

  .chart-card canvas
    height 240px !important

  .dashboard-section__header,
  .chart-heading,
  .daily-section__heading,
  .dashboard-hero__topline
    align-items flex-start
    flex-direction column

  .dashboard-hero__meta--inline
    grid-template-columns 1fr

  .daily-section__meta
    width 100%
    justify-content space-between

  .daily-section__pager
    width 100%
    justify-content space-between

  .daily-section__nav
    flex 1

@media (max-width: 640px)
  .dashboard-page
    margin-top 0.85rem

  .dashboard-hero__intro,
  .hero-card,
  .metric-card,
  .chart-card,
  .day-card,
  .dashboard-note
    padding 1rem

  .dashboard-hero__intro h1
    max-width none
    font-size 2rem

  .metric-value__number
    font-size 1.65rem

  .metric-value--compact .metric-value__number
    font-size 1.45rem

  .day-card__header
    flex-direction column
