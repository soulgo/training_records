<%
const dashboard = site.data.training || { daily: [], charts: {}, latest: {} };
const dashboardView = site.data.dashboardView || {};
const latestMeasurement = dashboardView.latestMeasurement || dashboard.latest?.measurement || null;
const latestDay = dashboardView.latestDay || dashboard.latest?.daily || null;
const previousDay = dashboardView.previousDay || null;
const recentDays = dashboardView.recentDays || [];
const recentDaysHtml = recentDays.map((d) => d.cardHtml).join('');
const dailyOverviewEntries = dashboardView.dailyOverviewEntries || [];
const dailyOverviewJson = JSON.stringify(dailyOverviewEntries.map(({ cardHtml, ...rest }) => rest));
const dailyCardLimit = dashboardView.dailyCardLimit || 4;
const dailyOverviewTotal = dashboardView.dailyOverviewTotal || dailyOverviewEntries.length;
const trainedDays = dashboardView.trainedDays || 0;
const totalArchivedDays = dashboardView.totalArchivedDays || dashboard.daily?.length || 0;
const chartPayload = dashboardView.chartPayload || { charts: dashboard.charts || {} };
const dailyOverviewHint = dashboardView.dailyOverviewHint || '顶部主卡按最新体脂归档日展示，最近活动以下方日期卡片为准';
const overviewStats = dashboardView.overviewStats || [];
const overviewMeta = dashboardView.overviewMeta || [];
const primaryMetrics = dashboardView.primaryMetrics || [];
const secondaryMetrics = dashboardView.secondaryMetrics || [];
const chartCards = dashboardView.chartCards || [];
function formatDailyRange(pageIndex, pageSize, total) {
  if (!total) {
    return '0 / 共 0 天';
  }

  const start = pageIndex * pageSize + 1;
  const end = Math.min(start + pageSize - 1, total);

  return `${start}-${end} / 共 ${total} 天`;
}
%>

<section class="dashboard-page">
  <% if (!latestMeasurement) { %>
    <div class="dashboard-empty">
      <p>还没有可展示的数据。先在仓库里补充 `训练记录.md`，然后重新构建站点。</p>
    </div>
  <% } else { %>
    <section class="dashboard-hero">
      <div class="dashboard-hero__intro">
        <div class="dashboard-hero__topline">
          <div class="dashboard-kicker">健康概览</div>
          <div class="dashboard-hero__meta dashboard-hero__meta--inline">
            <% overviewMeta.slice(0, 2).forEach((item) => { %>
              <div class="dashboard-hero__meta-item dashboard-hero__meta-item--inline">
                <span><%= item.label %></span>
                <strong><%= item.value %></strong>
              </div>
            <% }); %>
          </div>
        </div>
        <h1>最近归档的身体变化，一眼看清</h1>
        <p>体重、体脂率与训练消耗作为首页核心指标，先给出整体状态，再逐层展开趋势与细节。</p>
      </div>

      <div class="dashboard-hero__metrics">
        <% primaryMetrics.slice(0, 3).forEach((metric) => { %>
          <article class="hero-card">
            <div class="metric-card__head">
              <span class="hero-label"><%= metric.title %></span>
              <%- metric.comparisonHtml %>
            </div>
            <%- metric.valueHtml %>
            <div class="hero-card__meta"><%- metric.metaHtml %></div>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="dashboard-section dashboard-section--charts">
      <div class="dashboard-section__header dashboard-section__header--charts">
        <div>
          <span class="dashboard-section__eyebrow">最近 30 天</span>
          <h2>趋势变化</h2>
        </div>
        <p class="dashboard-section__lede">图表放在首页更靠前的位置，优先展示变化方向，而不是只看单日数值。</p>
      </div>
      <div class="chart-grid">
        <% chartCards.forEach((chart) => { %>
          <article class="chart-card <%= chart.className %>">
            <div class="chart-heading">
              <div>
                <h2><%= chart.title %></h2>
                <span><%= chart.subtitle %></span>
              </div>
            </div>
            <canvas id="<%= chart.id %>"></canvas>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="dashboard-strip">
      <div class="dashboard-strip__item">
        <span>最近归档</span>
        <strong><%= latestMeasurement.archivedDate %></strong>
      </div>
      <div class="dashboard-strip__item">
        <span>更新时间</span>
        <strong><%= latestMeasurement.timeLabel || latestMeasurement.updatedAt || '06:24' %></strong>
      </div>
      <div class="dashboard-strip__item dashboard-strip__item--quiet">
        <span>训练天数</span>
        <strong><%= trainedDays %> 天</strong>
      </div>
      <div class="dashboard-strip__item dashboard-strip__item--quiet">
        <span>累计归档</span>
        <strong><%= totalArchivedDays %> 天</strong>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <span class="dashboard-section__eyebrow">身体状态</span>
          <h2>基础指标</h2>
        </div>
      </div>
      <div class="metric-grid__cards metric-grid__cards--compact">
        <% secondaryMetrics.forEach((metric) => { %>
          <article class="metric-card metric-card--compact">
            <div class="metric-card__head">
              <span class="metric-title"><%= metric.title %></span>
              <%- metric.comparisonHtml %>
            </div>
            <%- metric.valueHtml %>
            <div class="metric-card__meta"><%- metric.metaHtml %></div>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="dashboard-section__header">
        <div>
          <span class="dashboard-section__eyebrow">训练表现</span>
          <h2>动作与消耗</h2>
        </div>
      </div>
      <div class="metric-grid__cards metric-grid__cards--training">
        <% overviewStats.forEach((item) => { %>
          <article class="metric-card metric-card--training">
            <span class="metric-title"><%= item.label %></span>
            <div class="metric-value metric-value--compact">
              <span class="metric-value__number"><%= item.value %></span>
              <% if (item.unit) { %><span class="metric-value__unit"><%= item.unit %></span><% } %>
            </div>
            <div class="metric-card__meta">
              <div class="metric-meta">
                <span><%= item.hint %></span>
                <strong><%= item.detail %></strong>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="daily-section">
      <div class="chart-heading daily-section__heading">
        <div>
          <span class="dashboard-section__eyebrow">活动归档</span>
          <h2>每日记录速览</h2>
          <span><%= dailyOverviewHint %></span>
        </div>
        <div class="daily-section__meta">
          <span class="daily-section__status" data-daily-status><%= formatDailyRange(0, dailyCardLimit, dailyOverviewTotal) %></span>
          <div class="daily-section__pager">
            <button type="button" class="daily-section__nav" data-daily-nav="prev" disabled>较新</button>
            <button
              type="button"
              class="daily-section__nav"
              data-daily-nav="next"
              <%= dailyOverviewTotal > dailyCardLimit ? '' : 'disabled' %>
            >较早</button>
          </div>
        </div>
      </div>
      <div class="daily-grid" data-daily-grid><%- recentDaysHtml %></div>
    </section>

    <% if (page.content) { %>
      <div class="dashboard-note"><%- page.content %></div>
    <% } %>

    <script id="training-dashboard-data" type="application/json"><%- JSON.stringify(chartPayload) %></script>
    <script id="daily-overview-data" type="application/json" data-page-size="<%= dailyCardLimit %>"><%- dailyOverviewJson %></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" integrity="sha384-JUh163oCRItcbPme8pYnROHQMC6fNKTBWtRG3I3I0erJkzNgL7uxKlNwcrcFKeqF" crossorigin="anonymous" defer></script>
    <script defer src="<%- url_for('/js/training-dashboard.js') %>"></script>
  <% } %>
</section>
