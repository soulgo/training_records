<%
const dashboard = site.data.training || { daily: [], charts: {}, latest: {} };
const dashboardView = site.data.dashboardView || {};
const actionMonitorView = site.data.actionMonitorView || {};
const actionMonitorRuns = actionMonitorView.runs || [];
const actionMonitorRecentRuns = actionMonitorView.recentRuns || actionMonitorRuns;
const actionMonitorHistoryRuns = actionMonitorView.historyRuns || [];
const actionMonitorHistoryPageSize = actionMonitorView.historyPageSize || 6;
const actionMonitorHistoryJson = JSON.stringify(actionMonitorHistoryRuns);
const actionMonitorSummaryCards = actionMonitorView.summaryCards || [];
const latestMeasurement = dashboardView.latestMeasurement || dashboard.latest?.measurement || null;
const latestDay = dashboardView.latestDay || dashboard.latest?.daily || null;
const previousDay = dashboardView.previousDay || null;
const recentDays = dashboardView.recentDays || [];
const recentDaysHtml = recentDays.map((d) => d.cardHtml).join('');
const dailyOverviewEntries = dashboardView.dailyOverviewEntries || [];
const dailyOverviewJson = JSON.stringify(dailyOverviewEntries.map(({ cardHtml, ...rest }) => rest));
const dailyCardLimit = dashboardView.dailyCardLimit || 4;
const dailyOverviewTotal = dashboardView.dailyOverviewTotal || dailyOverviewEntries.length;
const trainedDays = dashboardView.trainedDays || 0;
const totalArchivedDays = dashboardView.totalArchivedDays || dashboard.daily?.length || 0;
const chartPayload = dashboardView.chartPayload || { charts: dashboard.charts || {} };
const dailyOverviewHint = dashboardView.dailyOverviewHint || '顶部主卡按最新体脂归档日展示，最近活动以下方日期卡片为准';
const overviewStats = dashboardView.overviewStats || [];
const overviewMeta = dashboardView.overviewMeta || [];
const primaryMetrics = dashboardView.primaryMetrics || [];
const secondaryMetrics = dashboardView.secondaryMetrics || [];
const sleepSummary = latestDay?.sleepSummary || {};
const sleepCards = dashboardView.sleepCards || [{
  title: '睡眠核心数据',
  valueHtml: `<div class="metric-value metric-value--composite"><span class="metric-value__pair"><span class="metric-value__number">${sleepSummary.totalSleepMinutes ?? '—'}</span><span class="metric-value__unit">分钟</span></span><span class="metric-value__separator">/</span><span class="metric-value__pair"><span class="metric-value__number">${sleepSummary.nightSleepMinutes ?? '—'}</span><span class="metric-value__unit">夜间</span></span></div>`,
  metaHtml: `<div class="metric-meta"><span>午睡</span><strong>${sleepSummary.napMinutes ?? '—'} 分钟</strong></div>`,
  comparisonHtml: `<div class="metric-card__comparison comparison-pill comparison-pill--neutral"><div class="comparison-pill__summary"><span class="comparison-pill__arrow">☾</span><span>睡眠明细汇总</span><span class="comparison-pill__label" aria-hidden="true">恢复</span></div><span class="comparison-pill__value">${sleepSummary.deepSleepMinutes ?? '—'} / ${sleepSummary.remSleepMinutes ?? '—'}</span><span class="comparison-pill__meter"><span class="comparison-pill__meter-fill" style="width:${Math.max(18, Math.min(92, Number(sleepSummary.totalSleepMinutes || 0) / 6 || 18))}%"></span></span></div>`,
}];
const chartCards = dashboardView.chartCards || [];
function formatDailyRange(pageIndex, pageSize, total) {
  if (!total) {
    return '0 / 共 0 天';
  }

  const start = pageIndex * pageSize + 1;
  const end = Math.min(start + pageSize - 1, total);

  return `${start}-${end} / 共 ${total} 天`;
}

function formatActionRange(pageIndex, pageSize, total) {
  if (!total) {
    return '0 / 共 0 次';
  }

  const start = pageIndex * pageSize + 1;
  const end = Math.min(start + pageSize - 1, total);

  return `${start}-${end} / 共 ${total} 次`;
}
%>

<section class="dashboard-page">
  <% if (!latestMeasurement) { %>
    <div class="dashboard-empty">
      <p>还没有可展示的数据。先在仓库里补充 `训练记录.md`，然后重新构建站点。</p>
    </div>
  <% } else { %>
    <section class="dashboard-overview">
      <article class="overview-card">
        <div class="overview-card__header">
          <span class="dashboard-section__eyebrow">最新体脂归档日</span>
          <strong><%= latestMeasurement.archivedDate %></strong>
          <p>核心训练与身体指标总览</p>
        </div>
        <div class="overview-card__meta">
          <% overviewMeta.forEach((item, index) => { %>
            <div class="overview-card__meta-item <%= index === 0 ? 'overview-card__meta-item--highlight' : '' %>">
              <span><%= item.label %></span>
              <strong><%= item.value %></strong>
            </div>
          <% }); %>
        </div>
        <div class="overview-card__stats">
          <% overviewStats.forEach((item, index) => { %>
            <div class="overview-card__stat <%= index === 0 ? 'overview-card__stat--highlight' : '' %>">
              <span><%= item.label %></span>
              <strong><%= item.value %></strong>
              <small><%= item.hint %></small>
            </div>
          <% }); %>
        </div>
      </article>

      <section class="hero-metrics">
        <% primaryMetrics.forEach((metric, index) => { %>
          <article class="hero-card <%= index === 0 ? 'hero-card--highlight' : '' %>">
            <span class="hero-label"><%= metric.title %></span>
            <%- metric.valueHtml %>
            <div class="hero-card__meta"><%- metric.metaHtml %></div>
            <%- metric.comparisonHtml %>
          </article>
        <% }); %>
        <span class="sr-only">已训练天数</span>
      </section>
    </section>

    <section class="action-monitor" aria-label="GitHub Action 监控">
      <div class="dashboard-section__header action-monitor__header">
        <div>
          <span class="dashboard-section__eyebrow">ACTION MONITOR</span>
          <h2><%= actionMonitorView.title || 'Action 监控' %></h2>
        </div>
        <div class="action-monitor__meta">
          <span><%= actionMonitorView.environment || 'dev' %></span>
          <span>更新 <strong><%= actionMonitorView.updatedTime || '—' %></strong></span>
        </div>
      </div>

      <% if (actionMonitorSummaryCards.length) { %>
        <div class="action-monitor__summary" aria-label="Action 监控摘要">
          <% actionMonitorSummaryCards.forEach((card) => { %>
            <div class="action-monitor__summary-card">
              <span><%= card.label %></span>
              <strong><%= card.value %></strong>
              <small><%= card.hint %></small>
            </div>
          <% }); %>
        </div>
      <% } %>

      <% if (actionMonitorRecentRuns.length || actionMonitorHistoryRuns.length) { %>
        <div class="action-monitor__subheader">
          <div>
            <h3><%= actionMonitorView.recentWindowLabel || '最近 2 天' %></h3>
            <span>dev/main 各自读取对应分支的 PostgreSQL Action 日志</span>
          </div>
        </div>

        <% if (actionMonitorRecentRuns.length) { %>
          <div class="action-monitor__runs">
            <% actionMonitorRecentRuns.forEach((run) => { %>
              <a
                class="action-run action-run--<%= run.tone || 'neutral' %>"
                href="<%= run.htmlUrl || '#' %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="action-run__status" aria-label="<%= run.statusLabel || '未知' %>"></span>
                <div class="action-run__main">
                  <h3><%= run.title %></h3>
                  <p>
                    <span><%= run.workflowName %><% if (run.runNumber) { %> #<%= run.runNumber %><% } %></span>
                    <% if (run.commitShortSha) { %>
                      <span>Commit <strong><%= run.commitShortSha %></strong></span>
                    <% } %>
                    <% if (run.actorLogin) { %>
                      <span>pushed by <strong><%= run.actorLogin %></strong></span>
                    <% } %>
                  </p>
                  <% if (run.errorSummary) { %>
                    <small class="action-run__error"><%= run.errorSummary %></small>
                  <% } %>
                </div>
                <span class="action-run__branch"><%= run.branch || actionMonitorView.environment || 'dev' %></span>
                <div class="action-run__metrics">
                  <span><%= run.timeLabel || '—' %></span>
                  <span><%= run.durationLabel || '—' %></span>
                </div>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <div class="action-monitor__empty action-monitor__empty--compact">
            <strong>最近 2 天暂无 Action 运行</strong>
            <span>更早的 Action 记录保留在下面的历史分页里。</span>
          </div>
        <% } %>

        <% if (actionMonitorHistoryRuns.length) { %>
          <div class="action-monitor__history">
            <div class="action-monitor__history-heading">
              <div>
                <span class="dashboard-section__eyebrow">ACTION HISTORY</span>
                <h3><%= actionMonitorView.historyTitle || '更早 Action' %></h3>
              </div>
              <div class="action-monitor__history-controls">
                <span data-action-history-status><%= actionMonitorView.historyStatus || formatActionRange(0, actionMonitorHistoryPageSize, actionMonitorHistoryRuns.length) %></span>
                <button type="button" class="action-monitor__history-nav" data-action-history-nav="prev" disabled>较新</button>
                <button
                  type="button"
                  class="action-monitor__history-nav"
                  data-action-history-nav="next"
                  <%= actionMonitorHistoryRuns.length > actionMonitorHistoryPageSize ? '' : 'disabled' %>
                >较早</button>
              </div>
            </div>
            <div class="action-monitor__runs action-monitor__runs--history" data-action-history-grid>
              <% actionMonitorHistoryRuns.slice(0, actionMonitorHistoryPageSize).forEach((run) => { %>
                <a
                  class="action-run action-run--<%= run.tone || 'neutral' %>"
                  href="<%= run.htmlUrl || '#' %>"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="action-run__status" aria-label="<%= run.statusLabel || '未知' %>"></span>
                  <div class="action-run__main">
                    <h3><%= run.title %></h3>
                    <p>
                      <span><%= run.workflowName %><% if (run.runNumber) { %> #<%= run.runNumber %><% } %></span>
                      <% if (run.commitShortSha) { %>
                        <span>Commit <strong><%= run.commitShortSha %></strong></span>
                      <% } %>
                      <% if (run.actorLogin) { %>
                        <span>pushed by <strong><%= run.actorLogin %></strong></span>
                      <% } %>
                    </p>
                    <% if (run.errorSummary) { %>
                      <small class="action-run__error"><%= run.errorSummary %></small>
                    <% } %>
                  </div>
                  <span class="action-run__branch"><%= run.branch || actionMonitorView.environment || 'dev' %></span>
                  <div class="action-run__metrics">
                    <span><%= run.timeLabel || '—' %></span>
                    <span><%= run.durationLabel || '—' %></span>
                  </div>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="action-monitor__empty">
          <strong>暂无 Action 监控数据</strong>
          <span>Action 上报成功后，这里会显示最近运行状态、workflow、commit、分支和耗时。</span>
        </div>
      <% } %>
    </section>

    <% if (actionMonitorHistoryRuns.length) { %>
      <script id="action-history-data" type="application/json" data-page-size="<%= actionMonitorHistoryPageSize %>"><%- actionMonitorHistoryJson %></script>
    <% } %>

    <section class="metric-grid">
      <div class="dashboard-section__header">
        <div>
          <span class="dashboard-section__eyebrow">健康指标</span>
          <h2>身体状态</h2>
        </div>
      </div>
      <div class="metric-grid__cards">
        <% secondaryMetrics.forEach((metric, index) => { %>
          <article class="metric-card <%= index === 0 ? 'metric-card--highlight' : '' %>">
            <span class="metric-title"><%= metric.title %></span>
            <%- metric.valueHtml %>
            <div class="metric-card__meta"><%- metric.metaHtml %></div>
            <%- metric.comparisonHtml %>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="metric-grid metric-grid--sleep">
      <div class="dashboard-section__header">
        <div>
          <span class="dashboard-section__eyebrow">恢复指标</span>
          <h2>睡眠数据</h2>
        </div>
      </div>
      <div class="metric-grid__cards">
        <% sleepCards.forEach((metric, index) => { %>
          <article class="metric-card metric-card--sleep <%= index === 0 ? 'metric-card--highlight' : '' %>">
            <span class="metric-title"><%= metric.title %></span>
            <%- metric.valueHtml %>
            <div class="metric-card__meta"><%- metric.metaHtml %></div>
            <%- metric.comparisonHtml %>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="dashboard-charts">
      <div class="dashboard-section__header">
        <div>
          <span class="dashboard-section__eyebrow">趋势分析</span>
          <h2>最近 30 天</h2>
        </div>
      </div>
      <div class="chart-grid">
        <% chartCards.forEach((chart) => { %>
          <article class="<%= chart.className %>">
            <div class="chart-heading">
              <div>
                <h2><%= chart.title %></h2>
                <span><%= chart.subtitle %></span>
              </div>
              <div class="chart-legend" data-chart-legend-for="<%= chart.id %>"></div>
            </div>
            <canvas id="<%= chart.id %>"></canvas>
          </article>
        <% }); %>
      </div>
    </section>

    <section class="daily-section">
      <div class="chart-heading daily-section__heading">
        <div>
          <span class="dashboard-section__eyebrow">活动归档</span>
          <h2>每日记录速览</h2>
          <span><%= dailyOverviewHint %></span>
        </div>
        <div class="daily-section__meta">
          <span class="daily-section__status" data-daily-status><%= formatDailyRange(0, dailyCardLimit, dailyOverviewTotal) %></span>
          <div class="daily-section__pager">
            <button type="button" class="daily-section__nav" data-daily-nav="prev" disabled>较新</button>
            <button
              type="button"
              class="daily-section__nav"
              data-daily-nav="next"
              <%= dailyOverviewTotal > dailyCardLimit ? '' : 'disabled' %>
            >较早</button>
          </div>
        </div>
      </div>
      <div class="daily-grid" data-daily-grid><%- recentDaysHtml %></div>
    </section>

    <% if (page.content) { %>
      <div class="dashboard-note"><%- page.content %></div>
    <% } %>

    <script id="training-dashboard-data" type="application/json"><%- JSON.stringify(chartPayload) %></script>
    <script id="daily-overview-data" type="application/json" data-page-size="<%= dailyCardLimit %>"><%- dailyOverviewJson %></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" integrity="sha384-JUh163oCRItcbPme8pYnROHQMC6fNKTBWtRG3I3I0erJkzNgL7uxKlNwcrcFKeqF" crossorigin="anonymous" defer></script>
    <script defer src="<%- url_for('/js/training-dashboard.js') %>"></script>
  <% } %>
</section>
