<%
const actionMonitorView = site.data.actionMonitorView || {};
const actionMonitorRuns = actionMonitorView.runs || [];
const actionMonitorRecentRuns = actionMonitorView.recentRuns || actionMonitorRuns;
const actionMonitorHistoryRuns = actionMonitorView.historyRuns || [];
const actionMonitorLogRuns = actionMonitorView.allRuns ||
  (actionMonitorRecentRuns.length || actionMonitorHistoryRuns.length
    ? actionMonitorRecentRuns.concat(actionMonitorHistoryRuns)
    : actionMonitorRuns);
const scriptSafeJson = (value) => JSON.stringify(value)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
const actionMonitorHistoryPageSize = actionMonitorView.historyPageSize || 15;
const actionMonitorHistoryJson = scriptSafeJson(actionMonitorLogRuns);
const actionMonitorSummaryCards = actionMonitorView.summaryCards || [];
const parameterHealth = actionMonitorView.parameterHealth || {};
const parameterHealthCards = parameterHealth.summaryCards || [];
const parameterHealthItems = parameterHealth.items || [];
const parameterHealthPageSize = parameterHealth.pageSize || 5;
const parameterHealthVisibleItems = parameterHealth.visibleItems ||
  parameterHealthItems.slice(0, parameterHealthPageSize);
const parameterHealthTotal = parameterHealth.total || parameterHealthItems.length;
const parameterHealthJson = scriptSafeJson(parameterHealthItems);
const showParameterHealthPagination = Boolean(parameterHealth.paginationEnabled) ||
  parameterHealthTotal > 4;

function formatActionRange(pageIndex, pageSize, total) {
  if (!total) {
    return '0 / 共 0 次';
  }

  const start = pageIndex * pageSize + 1;
  const end = Math.min(start + pageSize - 1, total);

  return `${start}-${end} / 共 ${total} 次`;
}
%>

<section class="action-monitor-page">
  <section class="action-monitor" aria-label="GitHub Action 监控">
    <div class="action-monitor__header">
      <div>
        <span class="action-monitor__eyebrow">ACTION MONITOR</span>
        <h1><%= actionMonitorView.title || 'action 监控' %></h1>
      </div>
      <div class="action-monitor__meta">
        <span><%= actionMonitorView.environment || 'dev' %></span>
        <span>更新 <strong><%= actionMonitorView.updatedTime || '—' %></strong></span>
      </div>
    </div>

    <% if (actionMonitorSummaryCards.length) { %>
      <div class="action-monitor__summary" aria-label="Action 监控摘要">
        <% actionMonitorSummaryCards.forEach((card) => { %>
          <div class="action-monitor__summary-card">
            <span><%= card.label %></span>
            <strong><%= card.value %></strong>
            <small><%= card.hint %></small>
          </div>
        <% }); %>
      </div>
    <% } %>

    <section class="parameter-health" aria-label="系统参数健康">
      <div class="action-monitor__subheader">
        <div>
          <h2><%= parameterHealth.title || '系统参数健康' %></h2>
          <span><%= parameterHealth.environment || actionMonitorView.environment || 'dev' %> 真实 API 探测优先；仅存在不代表凭证可用</span>
        </div>
      </div>

      <% if (parameterHealthCards.length) { %>
        <div class="parameter-health__summary" aria-label="系统参数健康摘要">
          <% parameterHealthCards.forEach((card) => { %>
            <div class="action-monitor__summary-card">
              <span><%= card.label %></span>
              <strong><%= card.value %></strong>
              <small><%= card.hint %></small>
            </div>
          <% }); %>
        </div>
      <% } %>

      <% if (parameterHealthItems.length) { %>
        <% if (showParameterHealthPagination) { %>
          <div class="parameter-health__controls">
            <span data-parameter-health-status><%= parameterHealth.status || formatActionRange(0, parameterHealthPageSize, parameterHealthTotal).replace('次', '个') %></span>
            <button type="button" class="action-monitor__history-nav" data-parameter-health-nav="prev" disabled>较新</button>
            <button
              type="button"
              class="action-monitor__history-nav"
              data-parameter-health-nav="next"
              <%= parameterHealthTotal > parameterHealthPageSize ? '' : 'disabled' %>
            >较早</button>
          </div>
        <% } %>
        <div class="parameter-health__table" role="list" aria-label="系统参数健康列表">
          <div class="parameter-health__body" data-parameter-health-grid>
          <% parameterHealthVisibleItems.forEach((item) => { %>
            <div
              class="parameter-health__row parameter-health__row--<%= item.tone || 'neutral' %>"
              role="listitem"
              tabindex="0"
              data-parameter-health-open="<%= item.key %>"
            >
              <span class="parameter-health__identity">
                <strong class="parameter-health__name" title="<%= item.name %>"><%= item.name %></strong>
                <small><%= item.category %> · <%= item.scope %> · <%= item.evidenceLabel %></small>
              </span>
              <span class="parameter-health__due"><%= item.checkTypeLabel %><small><%= item.latencyLabel %> · <%= item.lastCheckedLabel %></small></span>
              <span class="parameter-health__state">
                <span class="parameter-health__status"><em><%= item.statusLabel %></em></span>
                <span class="parameter-health__message"><%= item.message || '—' %></span>
              </span>
            </div>
          <% }); %>
          </div>
        </div>
      <% } else { %>
        <div class="action-monitor__empty action-monitor__empty--compact">
          <strong><%= parameterHealth.emptyMessage || '暂无参数健康数据' %></strong>
          <span>参数健康 audit 完成真实探测并重新构建站点后，这里会显示 dev/main 的健康证据。</span>
        </div>
      <% } %>
    </section>

    <% if (parameterHealthItems.length) { %>
      <div class="parameter-health__modal" data-parameter-health-modal hidden role="dialog" aria-modal="true" aria-labelledby="parameter-health-modal-title">
        <div class="parameter-health__modal-backdrop" data-parameter-health-modal-close></div>
        <div class="parameter-health__modal-panel">
          <div class="parameter-health__modal-header">
            <div>
              <span class="action-monitor__eyebrow">PARAMETER DETAIL</span>
              <h3 id="parameter-health-modal-title">参数详情</h3>
            </div>
            <button type="button" class="parameter-health__modal-close" data-parameter-health-modal-close aria-label="关闭参数详情">×</button>
          </div>
          <div class="parameter-health__modal-name">
            <code data-parameter-health-modal-name></code>
          </div>
          <dl class="parameter-health__modal-fields">
            <div><dt>分类</dt><dd data-parameter-health-modal-category></dd></div>
            <div><dt>位置</dt><dd data-parameter-health-modal-scope></dd></div>
            <div><dt>状态</dt><dd data-parameter-health-modal-status></dd></div>
            <div><dt>探测方式</dt><dd data-parameter-health-modal-check></dd></div>
            <div><dt>证据来源</dt><dd data-parameter-health-modal-evidence></dd></div>
            <div><dt>探测耗时</dt><dd data-parameter-health-modal-latency></dd></div>
            <div><dt>最近检查</dt><dd data-parameter-health-modal-checked></dd></div>
            <div><dt>最近健康</dt><dd data-parameter-health-modal-healthy></dd></div>
            <div><dt>真实到期信息</dt><dd data-parameter-health-modal-expiry></dd></div>
            <div><dt>处理提示</dt><dd data-parameter-health-modal-message></dd></div>
          </dl>
        </div>
      </div>
    <% } %>

    <% if (actionMonitorLogRuns.length) { %>
      <div class="action-monitor__subheader">
        <div>
          <h2><%= actionMonitorView.recentWindowLabel || '全部 Action 日志' %></h2>
          <span>dev/main 各自读取对应分支的 PostgreSQL Action 日志</span>
        </div>
      </div>

      <div class="action-monitor__history">
        <div class="action-monitor__history-heading">
          <div>
            <span class="action-monitor__eyebrow">ACTION HISTORY</span>
            <h2><%= actionMonitorView.historyTitle || 'Action 日志' %></h2>
          </div>
          <div class="action-monitor__history-controls">
            <span data-action-history-status><%= actionMonitorView.historyStatus || formatActionRange(0, actionMonitorHistoryPageSize, actionMonitorLogRuns.length) %></span>
            <button type="button" class="action-monitor__history-nav" data-action-history-nav="prev" disabled>较新</button>
            <button
              type="button"
              class="action-monitor__history-nav"
              data-action-history-nav="next"
              <%= actionMonitorLogRuns.length > actionMonitorHistoryPageSize ? '' : 'disabled' %>
            >较早</button>
          </div>
        </div>
        <div class="action-monitor__runs action-monitor__runs--history" data-action-history-grid>
          <% actionMonitorLogRuns.slice(0, actionMonitorHistoryPageSize).forEach((run) => { %>
            <a
              class="action-run action-run--<%= run.tone || 'neutral' %>"
              href="<%= run.htmlUrl || '#' %>"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="action-run__status" aria-label="<%= run.statusLabel || '未知' %>"></span>
              <div class="action-run__main">
                <h3><%= run.title %></h3>
                <p>
                  <span><%= run.workflowName %><% if (run.runNumber) { %> #<%= run.runNumber %><% } %></span>
                  <% if (run.commitShortSha) { %>
                    <span>Commit <strong><%= run.commitShortSha %></strong></span>
                  <% } %>
                  <% if (run.actorLogin) { %>
                    <span>pushed by <strong><%= run.actorLogin %></strong></span>
                  <% } %>
                </p>
                <% if (run.errorSummary) { %>
                  <small class="action-run__error"><%= run.errorSummary %></small>
                <% } %>
              </div>
              <span class="action-run__branch"><%= run.branch || actionMonitorView.environment || 'dev' %></span>
              <div class="action-run__metrics">
                <span><%= run.timeLabel || '—' %></span>
                <span><%= run.durationLabel || '—' %></span>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div class="action-monitor__empty">
        <strong>暂无 Action 监控数据</strong>
        <span>Action 上报成功后，这里会显示最近运行状态、workflow、commit、分支和耗时。</span>
      </div>
    <% } %>
  </section>

  <% if (parameterHealthItems.length) { %>
    <script id="parameter-health-data" type="application/json" data-page-size="<%= parameterHealthPageSize %>"><%- parameterHealthJson %></script>
  <% } %>
  <% if (actionMonitorLogRuns.length) { %>
    <script id="action-history-data" type="application/json" data-page-size="<%= actionMonitorHistoryPageSize %>"><%- actionMonitorHistoryJson %></script>
  <% } %>
  <% if (actionMonitorLogRuns.length || parameterHealthItems.length) { %>
    <script defer src="<%- url_for('/js/action-monitor.js') %>"></script>
  <% } %>
</section>
