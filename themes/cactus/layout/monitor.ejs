<%
const monitorView = site.data.monitorView || {};
const summaryCards = monitorView.summaryCards || [];
const facts = monitorView.facts || { body: [], training: [], nutrition: [], recovery: [] };
const report = monitorView.dailyReport || {};
const reportSections = [
  { key: 'training', label: '训练建议', data: report.report?.training },
  { key: 'nutrition', label: '饮食建议', data: report.report?.nutrition },
  { key: 'recovery', label: '恢复建议', data: report.report?.recovery },
  { key: 'other', label: '其他提醒', data: report.report?.other },
];
const reportSourceLabel = report.source === 'ai' ? 'AI 已生成' : report.source === 'rules' ? '规则降级建议' : '等待生成';
%>

<section class="monitor-page">
  <% if (!monitorView.latestDataDate && !summaryCards.length) { %>
    <div class="monitor-empty">
      <span class="monitor-eyebrow">DAILY REPORT</span>
      <h1><%= monitorView.title || '每日训练报告' %></h1>
      <p>还没有可展示的每日数据。</p>
    </div>
  <% } else { %>
    <header class="monitor-header">
      <div>
        <span class="monitor-eyebrow">DAILY REPORT</span>
        <h1><%= monitorView.title || '每日训练报告' %></h1>
        <p class="monitor-header__subtitle">围绕最新一天的数据，给出下一步可执行动作。</p>
      </div>
      <div class="monitor-header__meta">
        <span>数据日期 <strong><%= monitorView.latestDataDate || '—' %></strong></span>
        <span>构建于 <strong><%= monitorView.updatedTime || '—' %></strong></span>
      </div>
    </header>

    <section class="monitor-report-panel" aria-label="每日 AI 报告">
      <div class="monitor-report-panel__heading">
        <div>
          <span class="monitor-eyebrow">COACH NOTE</span>
          <h2><%= report.report?.headline || '等待最新数据生成每日建议。' %></h2>
        </div>
        <span class="monitor-report-status monitor-report-status--<%= report.source || 'none' %>"><%= reportSourceLabel %></span>
      </div>
      <p class="monitor-report-panel__meta">建议基于 <%= report.latestDataDate || monitorView.latestDataDate || '最新数据' %> 更新，数据不完整时以保守建议为准。</p>
    </section>

    <section class="monitor-summary-grid" aria-label="最新数据摘要">
      <% summaryCards.forEach((card) => { %>
        <article class="monitor-summary-card monitor-summary-card--<%= card.tone || 'default' %>">
          <span><%= card.title %></span>
          <strong><%= card.value %></strong>
          <small><%= card.hint %></small>
          <% if (card.delta) { %><em><%= card.delta %></em><% } %>
        </article>
      <% }); %>
    </section>

    <section class="monitor-report-grid" aria-label="每日建议">
      <% reportSections.forEach((section) => { %>
        <article class="monitor-advice-panel monitor-advice-panel--<%= section.key %>">
          <div class="monitor-section-heading">
            <span class="monitor-eyebrow"><%= section.key.toUpperCase() %></span>
            <h2><%= section.label %></h2>
          </div>
          <p class="monitor-advice-summary"><%= section.data?.summary || '暂无足够数据。' %></p>
          <% if (section.data?.actions?.length) { %>
            <ul class="monitor-advice-list">
              <% section.data.actions.forEach((action) => { %>
                <li><%= action %></li>
              <% }); %>
            </ul>
          <% } %>
        </article>
      <% }); %>
    </section>

    <section class="monitor-facts-layout" aria-label="最新事实">
      <article class="monitor-facts-panel">
        <div class="monitor-section-heading">
          <span class="monitor-eyebrow">FACTS</span>
          <h2>最新数据</h2>
        </div>
        <div class="monitor-facts-grid">
          <% [
            ['身体', facts.body],
            ['训练', facts.training],
            ['饮食', facts.nutrition],
            ['恢复', facts.recovery],
          ].forEach(([label, items]) => { %>
            <div class="monitor-fact-group">
              <h3><%= label %></h3>
              <% (items || []).forEach((fact) => { %>
                <div class="monitor-fact-row"><span><%= fact.label %></span><strong><%= fact.value %></strong></div>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </article>

      <aside class="monitor-side-panel">
        <div class="monitor-section-heading">
          <span class="monitor-eyebrow">CHECK</span>
          <h2>数据状态</h2>
        </div>
        <div class="monitor-quality-value"><strong><%= monitorView.dataQuality?.completenessPct || 0 %>%</strong><span><%= monitorView.dataQuality?.label || '暂无数据' %></span></div>
        <div class="monitor-quality-bar" aria-hidden="true"><span style="width:<%= Math.max(0, Math.min(100, monitorView.dataQuality?.completenessPct || 0)) %>%"></span></div>
        <p><%= monitorView.dataQuality?.missingItems?.length ? `缺失：${monitorView.dataQuality.missingItems.join('、')}` : '关键数据已齐备' %></p>
        <div class="monitor-alerts">
          <% (monitorView.alerts || []).forEach((alert) => { %><span><%= alert %></span><% }); %>
        </div>
      </aside>
    </section>
  <% } %>
</section>
