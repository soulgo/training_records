<%
const thoughts = site.posts.sort('date', 'desc');
%>

<section class="thoughts-page">
  <div class="thoughts-hero">
    <span class="thoughts-kicker">Markdown · 随手更新 · 自动展示</span>
    <h1><%= page.title %></h1>
    <div class="thoughts-copy"><%- page.content %></div>
  </div>

  <% if (!thoughts.length) { %>
    <div class="thoughts-empty">
      <p>还没有锻炼随想。后续在 <code>source/_posts/</code> 下新增 Markdown 文件，这里会自动出现新的记录。</p>
    </div>
  <% } else { %>
    <div class="thoughts-list">
      <% thoughts.each(function(post) { %>
        <article class="thought-card">
          <div class="thought-card__meta">
            <time datetime="<%= full_date(post.date) %>"><%= date(post.date, 'YYYY-MM-DD HH:mm') %></time>
            <% if (post.tags && post.tags.length) { %>
              <div class="thought-card__tags">
                <% post.tags.each(function(tag) { %>
                  <span><%= tag.name %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
          <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
          <div class="thought-card__body">
            <%- post.excerpt || post.content %>
          </div>
          <a class="thought-card__link" href="<%- url_for(post.path) %>">阅读全文</a>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
