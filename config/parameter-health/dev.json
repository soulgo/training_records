{
  "environment": "dev",
  "probes": [
    {
      "key": "database_primary",
      "type": "postgres_connect",
      "env": {
        "url": "PARAMETER_HEALTH_DB_PRIMARY_URL"
      },
      "timeoutMs": 5000
    },
    {
      "key": "database_readonly",
      "type": "postgres_connect",
      "env": {
        "url": "PARAMETER_HEALTH_DB_READONLY_URL"
      },
      "timeoutMs": 5000
    },
    {
      "key": "database_migration",
      "type": "postgres_connect",
      "env": {
        "url": "PARAMETER_HEALTH_DB_MIGRATION_URL"
      },
      "timeoutMs": 5000
    },
    {
      "key": "ai_primary",
      "type": "openai_models",
      "env": {
        "token": "PARAMETER_HEALTH_AI_API_KEY",
        "baseUrl": "PARAMETER_HEALTH_AI_BASE_URL"
      },
      "timeoutMs": 8000
    },
    {
      "key": "ai_fallback",
      "type": "openai_models",
      "env": {
        "token": "PARAMETER_HEALTH_AI_FALLBACK_API_KEY",
        "baseUrl": "PARAMETER_HEALTH_AI_FALLBACK_BASE_URL"
      },
      "timeoutMs": 8000
    },
    {
      "key": "telegram_bot",
      "type": "telegram_get_me",
      "env": {
        "token": "PARAMETER_HEALTH_TELEGRAM_BOT_TOKEN"
      },
      "timeoutMs": 8000
    },
    {
      "key": "telegram_secret",
      "type": "presence",
      "env": {
        "value": "PARAMETER_HEALTH_TELEGRAM_SECRET_TOKEN"
      }
    },
    {
      "key": "feishu_credentials",
      "type": "feishu_tenant_token",
      "env": {
        "appId": "PARAMETER_HEALTH_FEISHU_APP_ID",
        "appSecret": "PARAMETER_HEALTH_FEISHU_APP_SECRET"
      },
      "timeoutMs": 8000
    },
    {
      "key": "cos_credentials",
      "type": "cos_head_bucket",
      "env": {
        "secretId": "PARAMETER_HEALTH_COS_SECRET_ID",
        "secretKey": "PARAMETER_HEALTH_COS_SECRET_KEY",
        "bucket": "PARAMETER_HEALTH_COS_BUCKET",
        "region": "PARAMETER_HEALTH_COS_REGION"
      },
      "timeoutMs": 8000
    },
    {
      "key": "cloudflare_api_token",
      "type": "cloudflare_token_verify",
      "env": {
        "token": "PARAMETER_HEALTH_CLOUDFLARE_API_TOKEN"
      },
      "timeoutMs": 8000
    },
    {
      "key": "cloudflare_pages_token",
      "type": "cloudflare_token_verify",
      "env": {
        "token": "PARAMETER_HEALTH_CLOUDFLARE_PAGES_API_TOKEN"
      },
      "timeoutMs": 8000
    },
    {
      "key": "worker_github_token",
      "type": "unsupported"
    },
    {
      "key": "feishu_encrypt_key",
      "type": "presence",
      "env": {
        "value": "PARAMETER_HEALTH_FEISHU_ENCRYPT_KEY"
      }
    },
    {
      "key": "feishu_verification_token",
      "type": "presence",
      "env": {
        "value": "PARAMETER_HEALTH_FEISHU_VERIFICATION_TOKEN"
      }
    }
  ],
  "parameters": [
    {
      "key": "dev.github.secret.DEV_TRAINING_DB_URL",
      "name": "DEV_TRAINING_DB_URL",
      "scope": "github_actions_secret",
      "category": "database",
      "required": true,
      "sensitive": true,
      "validityMode": "provider_metadata",
      "warningDays": 30,
      "criticalDays": 7,
      "owner": "ops",
      "sourceDoc": "docs/01_系统配置/dev.md",
      "sourceCode": [
        ".github/workflows/sync-dev.yml",
        ".github/workflows/deploy-cloudflare-pages-dev.yml"
